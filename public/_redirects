# Cloudflare Pages redirects. `trailingSlash: 'never'` + build.format 'file'
# means /about is the canonical path; these catch the slashed variants so an
# old or hand-typed link doesn't 404.
/events/      /events      301
/shop/        /shop        301
/community/   /community   301
/contact/     /contact     301

# Old About/Roster/Stats links. GitHub Pages ignores this
# file entirely — see docs/DEPLOY.md — so the real redirect mechanism today
# is the meta-refresh stubs at src/pages/{about,roster,stats}.ts. These rules
# exist so the move to Cloudflare Pages is correct on day one with no
# follow-up edit.
/about        /            302
/about/*      /            302
/roster       /            301
/roster/*     /            301
/stats        /events      301
/stats/*      /events      301

# The PRD's phase-2 news section is built as /blog (Nov 2026). On GitHub
# Pages the redirect is the src/pages/news.astro stub.
/news         /blog        301
/news/*       /blog        301
/blog/        /blog        301

# BCA-only "Pink Jersey Drop" renamed to the general "Leftovers Jersey"
# pre-order (Sept 2026).
/preorder/2026-pink-breast-cancer-awareness    /preorder/2026-leftovers-jersey    301
