# Cloudflare Pages redirects. `trailingSlash: 'never'` + build.format 'file'
# means /about is the canonical path; these catch the slashed variants so an
# old or hand-typed link doesn't 404.
/events/      /events      301
/shop/        /shop        301
/community/   /community   301
/contact/     /contact     301
/team/        /team        301

# About/Roster/Stats merged into /team (Oct 2026). GitHub Pages ignores this
# file entirely — see docs/DEPLOY.md — so the real redirect mechanism today
# is the meta-refresh stubs at src/pages/{about,roster,stats}.ts. These rules
# exist so the move to Cloudflare Pages is correct on day one with no
# follow-up edit.
/about        /team#story  301
/about/*      /team#story  301
/roster       /team#crew   301
/roster/*     /team#crew   301
/stats        /team#stats  301
/stats/*      /team#stats  301

# The PRD's phase-2 news section isn't built yet; point early links at events.
/news         /events      302
/news/*       /events      302
