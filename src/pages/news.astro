---
/**
 * /news is the PRD's name for the recap posts (§12). They're built as /blog,
 * so old /news links redirect there. An .astro page, not a .ts endpoint: an
 * endpoint builds to a file with no extension, which GitHub Pages serves as
 * a download. The stub is noindex, so the sitemap step drops it.
 */
import { redirectHtml } from '@/lib/redirect-page';
---

<Fragment set:html={redirectHtml('/blog', 'Blog', Astro.site!.href)} />
