---
/**
 * /blog/<slug>: one published post. Drafts never build here; they build at
 * /preview/blog/<slug> instead (src/pages/preview/blog/[slug].astro).
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPosts, summarize } from '@/lib/posts';

export const getStaticPaths = (async () =>
  (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }))) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const summary = await summarize(post);
---

<PostLayout post={post} summary={summary}>
  <Content />
</PostLayout>
