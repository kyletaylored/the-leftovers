---
/**
 * /gallery — every photo from the galleries collection: one large photo with
 * a paged grid of thumbnails to jump around.
 *
 * Built for bandwidth, because a photo page is the heaviest thing on the site.
 * Only small thumbnails for the current grid page load, plus the large photo
 * in view and its neighbours; the rest load as they're reached. See the
 * `grid` indicator in Slideshow.tsx. Linked from the footer only, for now.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import GallerySlideshow from '@/components/GallerySlideshow.astro';
import { resolveHeroImages } from '@/lib/images';

const page = await getEntry('pages', 'gallery');
if (!page) throw new Error('Missing content file: src/content/pages/gallery.md');
const heroImages = await resolveHeroImages(page.data.heroImages);
const galleries = await getCollection('galleries');
---

<BaseLayout
  noindex={page.data.seo.noindex}
  title={page.data.seo.title ?? page.data.title}
  description={page.data.seo.description}
>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} images={heroImages} />

  <Section tone="base">
    <GallerySlideshow
      galleries={galleries}
      layout="single"
      indicators="grid"
      captionStyle="flag"
      class="mx-auto max-w-5xl"
    />
  </Section>
</BaseLayout>
