---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Prose from '@/components/Prose.astro';
import Button from '@/components/Button.astro';
import { resolveHeroImages } from '@/lib/images';

const page = await getEntry('pages', 'terms');
if (!page) throw new Error('Missing content file: src/content/pages/terms.md');
const heroImages = await resolveHeroImages(page.data.heroImages);
const { Content } = await render(page);
---

<BaseLayout
  noindex={page.data.seo.noindex}
  title={page.data.seo.title ?? page.data.title}
  description={page.data.seo.description}
>
  <PageHeader
    eyebrow={page.data.eyebrow}
    title={page.data.title}
    intro={page.data.intro}
    images={heroImages}
  />

  <Section tone="base">
    <Prose>
      <Content />
    </Prose>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/privacy" variant="outline" size="sm">
        Read Privacy Policy
      </Button>
      <Button href="/contact" variant="ghost" size="sm">
        Contact the crew
      </Button>
    </div>
  </Section>
</BaseLayout>
