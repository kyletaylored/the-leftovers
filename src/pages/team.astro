---
/**
 * /team — who we are, who runs it and how to get in, on one page.
 *
 * Nov 2026: the roster and hand-entered stats are gone. Players rotate event
 * by event, so the people listed are the organizers (`team` collection), and
 * the record lives on /events, worked out from each event's squads.
 *
 * /about, /roster and /stats still exist as thin redirect pages (see those
 * files) rather than disappearing outright — old links and bookmarks land
 * here instead of 404ing.
 */
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Prose from '@/components/Prose.astro';
import StatNumber from '@/components/StatNumber.astro';
import Callout from '@/components/Callout.astro';
import CtaStrip from '@/components/CtaStrip.astro';
import Button from '@/components/Button.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import ProfileCard from '@/components/ProfileCard.astro';
import ThreeColumn from '@/components/ThreeColumn.astro';
import GallerySlideshow from '@/components/GallerySlideshow.astro';
import TeamStatsWidget from '@/components/TeamStatsWidget.astro';
import { resolveHeroImages, resolveImage } from '@/lib/images';
import { getEvents, seasonOf } from '@/lib/events';
import { getTeamWidgets, ATTRIBUTION as PBLIDB_ATTRIBUTION } from '@/lib/pblidb';
import { site } from '@/lib/settings';

const socialLinks = (socials: CollectionEntry<'team'>['data']['socials']) =>
  (['instagram', 'tiktok', 'youtube'] as const).flatMap((icon) => {
    const href = socials[icon];
    return href ? [{ icon, href, label: icon[0].toUpperCase() + icon.slice(1) }] : [];
  });

const page = await getEntry('pages', 'team');
if (!page) throw new Error('Missing content file: src/content/pages/team.md');
const { Content } = await render(page);

const heroImages = await resolveHeroImages(page.data.heroImages);

const [members, faqs, galleries, { past }, pblidbWidgets] = await Promise.all([
  getCollection('team'),
  getCollection('faqs'),
  getCollection('galleries'),
  getEvents(),
  getTeamWidgets(site.pblidb.query),
]);

const team = await Promise.all(
  members
    .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
    .map(async (member) => ({
      member,
      photo: await resolveImage(member.data.photo),
      links: socialLinks(member.data.socials),
      ...(await render(member)),
    }))
);

// Worked out from each event's squads, never typed in.
const record = [
  { value: new Set(past.map(seasonOf)).size, label: 'Seasons' },
  { value: past.length, label: 'Events' },
  { value: past.reduce((total, event) => total + event.data.squads.length, 0), label: 'Squads entered' },
];

const faqItems = faqs
  .sort((a, b) => a.data.order - b.data.order)
  .map((faq) => ({ question: faq.data.question, answer: faq.data.answer }));

const howItWorks = [
  {
    icon: 'chat' as const,
    title: 'Say you’re in',
    body: 'Send a join request or email the captain. No application, no tryout date to wait for.',
  },
  {
    icon: 'calendar' as const,
    title: 'Confirm the date',
    body: 'Slots go in the order people confirm. Confirming means you’re actually showing up — we plan the squad around it.',
  },
  {
    icon: 'jersey' as const,
    title: 'Show up and play',
    body: 'Cover your entry and paint, bring your own marker and mask, and you’re playing points. Nobody sits.',
  },
];

/** SportsTeam + its organizers + FAQ. */
const schema = [
  {
    '@type': 'SportsTeam',
    '@id': new URL('/#team', Astro.site).href,
    member: team.map(({ member }) => ({
      '@type': 'Person',
      name: member.data.name,
      jobTitle: member.data.role,
      ...(member.data.socials.instagram ? { sameAs: [member.data.socials.instagram] } : {}),
    })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];

const jumpLinks = [
  { href: '#story', label: 'Story' },
  { href: '#crew', label: 'Team' },
  { href: '#join', label: 'Join' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#faq', label: 'FAQ' },
];
---

<BaseLayout noindex={page.data.seo.noindex} title={page.data.seo.title ?? page.data.title} description={page.data.seo.description} schema={schema}>
  <PageHeader
    eyebrow={page.data.eyebrow}
    title={page.data.title}
    intro={page.data.intro}
    images={heroImages}
  />

  {/* One page, several sections — a jump row so it doesn't just feel like an
      endless scroll with no wayfinding. */}
  <nav aria-label="On this page" class="border-b border-ink-600/60 bg-ink-900">
    <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-4 sm:px-6">
      {
        jumpLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="tap inline-flex items-center whitespace-nowrap px-3 text-[0.7rem] font-bold uppercase tracking-[0.14em] text-bone-muted transition-colors hover:text-gold-300"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- STORY ------------------------------------------------------------------>
  <Section id="story" tone="base">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-16">
      <Prose>
        <Content />
      </Prose>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-sm border border-ink-600 bg-ink-800 p-6">
          <h2 class="text-2xl text-bone">The record</h2>
          <div class="mt-5 grid grid-cols-2 gap-y-6">
            {record.map((item) => <StatNumber value={item.value} label={item.label} size="sm" />)}
          </div>
          <Button href="/events" variant="outline" size="sm" class="mt-6 w-full">
            Season by season
          </Button>
        </div>

        <Callout class="mt-6" cite={`— Est. ${site.established}${site.homeBase ? `, ${site.homeBase}` : ''}`}>
          We're the players who were left over, and we'd rather hand the next person a slot than
          make them wait a season for one.
        </Callout>
      </aside>
    </div>
  </Section>

  <!-- TEAM ------------------------------------------------------------------>
  <Section id="crew" tone="alt" eyebrow="Who runs it" title="Team Members">
    <div class="grid gap-4 sm:gap-5 lg:grid-cols-2">
      {
        team.map(({ member, photo, links, Content: Bio }) => (
          <ProfileCard
            name={member.data.name}
            role={member.data.role}
            image={photo}
            imageAlt={member.data.photoAlt}
            links={links}
          >
            <Bio />
          </ProfileCard>
        ))
      }
    </div>
  </Section>

  <!-- JOIN ----------------------------------------------------------------->
  <Section id="join" tone="base" eyebrow="Free agents welcome" title="How to Join">
    <ThreeColumn items={howItWorks} as="h3" />

    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/join">Send a join request</Button>
      <Button href="/contact" variant="outline">Email the captain</Button>
    </div>
  </Section>

  <!-- GALLERY --------------------------------------------------------------->
  <Section id="gallery" tone="alt" title="From the Crew" kicker="Photos" divider dividerSeed={31}>
    <GallerySlideshow
      galleries={galleries}
      emptyTitle="No team photos up yet"
      emptyBody="Game days, roster nights, whatever's on someone's phone after a tournament. Add them in the CMS and they show up here."
      class="mx-auto max-w-4xl"
    />
  </Section>

  <!-- PBLIDB (third-party, live) ------------------------------------------------>
  {
    pblidbWidgets.length > 0 && (
      <Section tone="alt" eyebrow="Public record" title="On pblidb.org">
        <p class="max-w-2xl text-base leading-relaxed text-bone-muted">
          pblidb.org is an independent, unofficial database built from public PBLeague pages. It has
          indexed more than one team named "Leftovers" over the years, so every match shows up
          below rather than us guessing which one is "the real one."
        </p>

        {
          pblidbWidgets.length > 3 && (
            <div class="mt-6 max-w-sm">
              <label for="pblidb-filter" class="field-label">Filter by team name</label>
              <input
                id="pblidb-filter"
                type="search"
                placeholder="e.g. III, NOV, OG…"
                class="field-input tap"
                data-pblidb-filter
              />
            </div>
          )
        }

        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-pblidb-grid>
          {pblidbWidgets.map((widget) => (
            <li>
              <TeamStatsWidget widget={widget} class="h-full" />
            </li>
          ))}
        </ul>

        <p class="mt-4 text-xs text-bone-muted">{PBLIDB_ATTRIBUTION}</p>
      </Section>
    )
  }

  {
    pblidbWidgets.length > 3 && (
      <script>
        // Progressive enhancement only — every widget is visible without this.
        document.querySelectorAll<HTMLInputElement>('[data-pblidb-filter]').forEach((input) => {
          const grid = input.closest('section')?.querySelector<HTMLElement>('[data-pblidb-grid]');
          if (!grid) return;
          const items = grid.querySelectorAll<HTMLElement>('[data-team-name]');
          input.addEventListener('input', () => {
            const needle = input.value.trim().toLowerCase();
            items.forEach((item) => {
              const li = item.closest('li');
              if (!li) return;
              li.style.display = !needle || item.dataset.teamName?.includes(needle) ? '' : 'none';
            });
          });
        });
      </script>
    )
  }

  <!-- FAQ ----------------------------------------------------------------------->
  <Section id="faq" tone="alt" title="Common Questions" kicker="Before you ask">
    <FaqAccordion items={faqItems} class="max-w-3xl" />
  </Section>

  <Section tone="base">
    <CtaStrip
      tone="forest"
      eyebrow="Rotating roster"
      title="There's a slot open"
      body="No tryout, no dues, no bench. Cover your entry and paint and you're playing points at the next event."
    >
      <Button slot="actions" href="#join" variant="gold" size="lg">How to join</Button>
      <Button slot="actions" href="/join" variant="ghost" size="lg" class="!border-bone/40 !text-bone hover:!border-bone">
        Send a join request
      </Button>
    </CtaStrip>
  </Section>
</BaseLayout>
