---
/**
 * The roster was removed (Nov 2026); keeps old links from 404ing.
 * An .astro page, not a .ts endpoint: an endpoint builds to a file with no
 * extension, which GitHub Pages serves as a download instead of a web page.
 */
import { redirectHtml } from '@/lib/redirect-page';
---

<Fragment set:html={redirectHtml('/', 'Home', Astro.site!.href)} />
