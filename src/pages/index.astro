---
/**
 * Home.
 *
 * Deliberately a COMMUNITY page, not a team dashboard. The order answers a
 * newcomer's questions in the order they'd ask them: what is this → how do I
 * get in → when's the next one → can I get updates.
 *
 * Nov 2026: this is the "direction B" layout from
 * `docs/design/homepage-mockup-b.webp`, reviewed at /preview/home-b and
 * promoted here by the team. Ornate hero on bg-sand → ImpactBand (manifesto
 * + why it's different) → full-width showcase slider of the game-day gallery
 * → a boxed TwoColumn "How it works" CTA (so the two full-bleed photo blocks
 * never touch) → crimson ImpactBand for free agents → "2027 Season
 * Loading…" with the leagues → newsletter.
 *
 * Earlier the same month (website feedback) the community-channels,
 * open-slots and "From the Field" blocks were removed because the pages they
 * pointed at (Team, Community) are hidden. Events drive nothing here, so
 * there is no SportsEvent structured data on this page.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import TwoColumn from '@/components/TwoColumn.astro';
import ImpactBand from '@/components/marketing/ImpactBand.astro';
import GallerySlideshow from '@/components/GallerySlideshow.astro';
import NewsletterBlock from '@/components/NewsletterBlock.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import Button from '@/components/Button.astro';
import { site } from '@/lib/settings';
import { resolveImage } from '@/lib/images';
import shooter from '@/assets/img/events/nxl-wc25/lo2nxlwc25-94-x5.webp';
import aiming from '@/assets/img/events/nxl-lso26/lo2nxllso26-219-x5.webp';
import huddle from '@/assets/img/events/nxl-lsm25/frinxllsm25ls-1427-x5.webp';

const galleries = await getCollection('galleries');
const sliderGalleries = galleries.filter((gallery) => gallery.id === 'game-day');

// The site itself as an entity, published by the team entity BaseLayout
// emits on every page (linked by @id rather than repeated).
const websiteSchema = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: new URL('/', Astro.site).href,
  name: site.title,
  description: site.description,
  inLanguage: 'en-US',
  publisher: { '@id': new URL('/#team', Astro.site).href },
};

const leagues = await Promise.all(
  site.leagues.map(async (league) => ({
    name: league.name,
    alt: league.logoAlt,
    src: await resolveImage(league.logo),
  }))
);
---

<BaseLayout title={site.title} description={site.description} schema={[websiteSchema]}>
  <Hero variant="ornate" animate tagline={`Paintball team / ${site.tagline}`}>
    <Button slot="actions" href="/join" size="lg">Join a squad</Button>
  </Hero>

  <ImpactBand
    image={shooter}
    imageAlt="A Leftovers player in a mask and team jersey aims a paintball marker across a field."
    eyebrow="Play hard"
    title={'Paintball builds\nbetter people.'}
    body="A community-run team built from rotating free agents. Show up, play points, make friends on the field."
    stats={[
      { value: '0', label: 'Tryouts' },
      { value: '0', label: 'Bench spots' },
      { value: '100%', label: 'Playing time' },
    ]}
    ghost="Play"
  >
    <Button slot="actions" href="/join" size="lg">Join a squad</Button>
  </ImpactBand>

  <section class="bg-ink">
    <div class="mx-auto max-w-5xl px-4 pb-10 pt-16 text-center sm:px-6 lg:pt-24">
      <p class="eyebrow mb-4">{site.tagline}</p>
      <h2 class="mx-auto max-w-3xl text-2xl leading-tight text-bone sm:text-4xl lg:text-5xl">
        <span class="block">Don’t miss the action.</span>
        <span class="block">Expand your network.</span>
        <span class="block">Make memories.</span>
      </h2>
    </div>
    <GallerySlideshow galleries={sliderGalleries} layout="showcase" autoplayMs={6000} />
  </section>

  {/* A calm, boxed two-column CTA between the two full-bleed photo blocks,
      so the slider and the crimson band never butt up against each other. */}
  <Section tone="seigaiha">
    <TwoColumn
      eyebrow="How it works"
      title="Three steps to the field"
      image={huddle}
      imageAlt="Leftovers players in a tight huddle with their arms together and paint pods on their hips."
      imageSide="right"
    >
      <ol class="space-y-3">
        <li><strong class="text-bone">No tryout.</strong> Say you’re coming and tell us what you want to compete in.</li>
        <li><strong class="text-bone">Bring your own gear.</strong> Your marker, your mask, your style.</li>
        <li><strong class="text-bone">You actually play.</strong> No bench: if you confirmed, you’re playing points.</li>
      </ol>
      <Button slot="actions" href="/join">Join a squad</Button>
      <Button slot="actions" href="/contact" variant="outline">Ask a question</Button>
    </TwoColumn>
  </Section>

  <ImpactBand
    image={aiming}
    imageAlt="A Leftovers player crouched behind an inflatable bunker sights down a paintball marker."
    align="right"
    tone="crimson"
    eyebrow="Free agents welcome"
    title={'No team?\nNo problem.'}
    body="If you have no team at all, or your team is missing an event you still want to attend, we have a spot for you."
  >
    <Button slot="actions" href="/join" variant="gold" size="lg">Request to join</Button>
  </ImpactBand>

  <Section tone="alt" eyebrow="Next up" title="On the Calendar">
    <div class="rounded-sm border border-ink-600 bg-ink-800 px-6 py-10 text-center sm:px-10 sm:py-14">
      <h3 class="text-3xl text-bone sm:text-5xl">2027 Season Loading…</h3>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-bone-muted sm:text-base">
        Dates go up as the leagues release them. Send a join request and we’ll follow up as soon
        as there’s an event to play.
      </p>
      <div class="mt-6">
        <Button href="/join" size="sm">Request to join</Button>
      </div>
      <LogoStrip items={leagues} label="Leagues we want to build in" size="sm" class="mt-12" />
    </div>
  </Section>

  <Section tone="base">
    <NewsletterBlock />
  </Section>
</BaseLayout>
