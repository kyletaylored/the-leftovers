---
/**
 * /join — request-to-play form (name, contact, division, player class,
 * event, payment method). Added when the team stopped running a Discord:
 * this is now the actual mechanism for "how do I get on the roster for an
 * upcoming event," replacing "ask in the event channel."
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';
import Prose from '@/components/Prose.astro';
import JoinRequestForm from '@/components/JoinRequestForm.tsx';
import { resolveHeroImages } from '@/lib/images';
import { getEvents } from '@/lib/events';
import { dateRange } from '@/lib/format';
import { site } from '@/lib/settings';

const page = await getEntry('pages', 'join');
if (!page) throw new Error('Missing content file: src/content/pages/join.md');
const heroImages = await resolveHeroImages(page.data.heroImages);
const { Content } = await render(page);

const { upcoming } = await getEvents();
const events = upcoming.map((event) => ({
  id: event.id,
  label: `${event.data.title} — ${dateRange(event.data.startDate, event.data.endDate)}`,
}));
---

<BaseLayout title={page.data.seo.title ?? page.data.title} description={page.data.seo.description}>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} images={heroImages} />

  <Section tone="base">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] lg:gap-16">
      <div>
        <Prose>
          <Content />
        </Prose>
      </div>

      <div>
        <JoinRequestForm
          client:visible
          events={events}
          paymentMethods={site.join.paymentMethods}
          endpoint={site.join.endpoint || undefined}
          provider={site.join.provider || undefined}
          fieldMap={site.join.fieldMap}
          teamEmail={site.social.email}
        />
      </div>
    </div>
  </Section>
</BaseLayout>
