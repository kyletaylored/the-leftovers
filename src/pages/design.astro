    <DocSection id="index" number={num('index')} title="Component index" kicker="Check here before writing a new component" intro="Every reusable component, where it lives and when to reach for it. Paths are relative to src/components/. Rows marked Storybook also have a *.stories.tsx with interactive states and play tests. Rendered from src/lib/components.ts, which also generates docs/COMPONENTS.md: the options, data, pairings and page recipes, written for AI agents.">
      <div class="overflow-x-auto border border-[#DAD4C4] bg-[#FBF9F4]">
        <table class="w-full min-w-[720px] border-collapse text-[0.8125rem]">
          <thead>
            <tr class="bg-ink text-left text-[0.625rem] font-bold uppercase tracking-[0.1em] text-gold-300">
              <th scope="col" class="px-4 py-2.5">Component</th>
              <th scope="col" class="px-4 py-2.5">File</th>
              <th scope="col" class="px-4 py-2.5">Kind</th>
              <th scope="col" class="px-4 py-2.5">Storybook</th>
              <th scope="col" class="px-4 py-2.5">Use it for</th>
            </tr>
          </thead>
          <tbody>
            {index.map((row, i) => (
              <tr class:list={['border-b border-[#DAD4C4]', i % 2 === 1 && 'bg-[#F3F0E7]']}>
                <td class="px-4 py-2.5 font-semibold"><a href={`#${row.section}`} class="text-crimson hover:text-crimson-600">{row.name}</a></td>
                <td class="px-4 py-2.5"><code class="font-mono text-xs text-[#3a342b]">{row.file}</code></td>
                <td class="px-4 py-2.5 text-[#4a443a]">{row.kind}</td>
                <td class="px-4 py-2.5 text-[#4a443a]">{row.story ? 'Yes' : '—'}</td>
                <td class="px-4 py-2.5 text-[#4a443a]">{row.use}{row.internal && <span class="text-[#8a8170]"> (internal)</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </DocSection>
    </div>
    </div>
  </div>
</BaseLayout>
