            legend="Radio group: gear"
            name="demo-gear"
            defaultValue="own"
            options={[
              { value: 'own', label: 'I have my own marker, mask & pods' },
              { value: 'borrow', label: 'I need to borrow some gear' },
              { value: 'unsure', label: 'Not sure yet' },
            ]}
          />
          <CheckboxGroup
            legend="Checkbox group: notify me"
            name="demo-notify"
            defaultValues={['roster', 'jerseys']}
            options={[
              { value: 'roster', label: 'Roster openings' },
              { value: 'jerseys', label: 'Jersey drops' },
              { value: 'results', label: 'Event results' },
            ]}
          />
        </div>

        <div class="my-8 h-px bg-ink-600" />

        <p class="field-label mb-4">Field group: roster enquiry</p>
        <div class="mb-6 grid gap-5 md:grid-cols-3">
          <FormField label="Name" name="demo-g-name" placeholder="Your name" />
          <FormField label="Email" name="demo-g-email" type="email" placeholder="you@example.com" />
          <FormField label="Which event?" name="demo-g-event" as="select">
            {allEvents.length > 0 ? allEvents.map((e) => <option>{e.data.title}</option>) : <option>Next event TBD</option>}
          </FormField>
        </div>
        <p class="field-label mb-4">Action buttons</p>
        <div class="flex flex-wrap items-center gap-3.5">
          <Button type="submit" icon={false}>Submit Enquiry</Button>
          <Button variant="outline" icon={false}>Cancel</Button>
          <Button disabled icon={false}>Submitting…</Button>
          <Button variant="tertiary" icon={false}>Reset Form</Button>
        </div>
      </Specimen>
    </DocSection>

    {/* ========================================================= CALENDAR */}
    <DocSection id="calendar" number="04.7" title="Calendar" kicker="Month grid + compact agenda">
      <div class="grid items-start gap-5 lg:grid-cols-2">
        <Specimen title="Month grid" tag="React island" file={['src/components/EventsCalendar.astro', 'src/components/Calendar.tsx']} note="Marked days are real #slug links to the matching EventCard, so it works with zero JS; only month navigation is the island. Opens on the next event's month, never a blank January.">
          <EventsCalendar events={allEvents} next={next} class="mx-auto max-w-md" />
        </Specimen>
        <Specimen title="Agenda list: compact" tag="NEW" file="src/components/AgendaList.astro" note="The lighter alternative when there are only 1–2 events. Flags next as Next Up; the TBD row keeps a short schedule from reading as 'season over'. linkToCards turns rows into #slug jumps.">
          <AgendaList events={upcoming} next={next} as="h4" />
        </Specimen>
      </div>
    </DocSection>

    {/* ========================================================== IMAGERY */}
    <DocSection id="imagery" number="06" title="Imagery placeholders" kicker="Real photography lands later; these hold slots on-brand meanwhile">
      <Specimen title="ImagePlaceholder" tag="NEW" file="src/components/ImagePlaceholder.astro" note="Striped, labelled, brand borders. Never a broken-image icon or an empty grey box. The label is announced (role=img), so name the shot. Ratios match the real component slots.">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div><ImagePlaceholder label="player photo" ratio="4/5" showRatio /><p class="mt-1.5 text-[0.6875rem] text-bone-muted">PlayerCard</p></div>
          <div><ImagePlaceholder label="event cover" ratio="16/9" angle={115} showRatio /><p class="mt-1.5 text-[0.6875rem] text-bone-muted">EventCard</p></div>
          <div><ImagePlaceholder label="product shot" ratio="1/1" angle={65} showRatio /><p class="mt-1.5 text-[0.6875rem] text-bone-muted">ProductCard</p></div>
          <div><ImagePlaceholder label="action photo" ratio="3/2" angle={95} showRatio /><p class="mt-1.5 text-[0.6875rem] text-bone-muted">Gallery / hero</p></div>
        </div>
      </Specimen>
    </DocSection>

    {/* ============================================================ INDEX */}
    <DocSection id="index" number="07" title="Component index" kicker="Check here before writing a new component" intro="Every reusable component, where it lives and when to reach for it. Paths are relative to src/components/. Rows marked Storybook also have a *.stories.tsx with interactive states and play tests.">
      <div class="overflow-x-auto border border-[#DAD4C4] bg-[#FBF9F4]">
        <table class="w-full min-w-[720px] border-collapse text-[0.8125rem]">
          <thead>
            <tr class="bg-ink text-left text-[0.625rem] font-bold uppercase tracking-[0.1em] text-gold-300">
              <th scope="col" class="px-4 py-2.5">Component</th>
              <th scope="col" class="px-4 py-2.5">File</th>
              <th scope="col" class="px-4 py-2.5">Kind</th>
              <th scope="col" class="px-4 py-2.5">Storybook</th>
              <th scope="col" class="px-4 py-2.5">Use it for</th>
            </tr>
          </thead>
          <tbody>
            {index.map((row, i) => (
              <tr class:list={['border-b border-[#DAD4C4]', i % 2 === 1 && 'bg-[#F3F0E7]']}>
                <td class="px-4 py-2.5 font-semibold"><a href={`#${row.section}`} class="text-crimson hover:text-crimson-600">{row.name}</a></td>
                <td class="px-4 py-2.5"><code class="font-mono text-xs text-[#3a342b]">{row.file}</code></td>
                <td class="px-4 py-2.5 text-[#4a443a]">{row.kind}</td>
                <td class="px-4 py-2.5 text-[#4a443a]">{row.story ? 'Yes' : '—'}</td>
                <td class="px-4 py-2.5 text-[#4a443a]">{row.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </DocSection>
  </div>
</BaseLayout>
