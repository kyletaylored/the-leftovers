---
/**
 * /design — the living design-system storybook.
 *
 * Implements the "Leftovers Design Storybook" reference
 * (`_reference/Leftovers_Design_Storybook/index.html`, gitignored) with the
 * REAL components rather than the reference's inline-styled mockups: every
 * specimen below is the production component rendered with real content
 * collections, so this page can't drift from what ships.
 *
 * It is the reference to check before building a page (reuse what's here)
 * and the place to document a new component (add a specimen + an index row).
 * See AGENTS.md → "Design system". React islands are ALSO documented in
 * Storybook (`npm run storybook`), which is where their interactive states
 * and play tests live; Astro components can only be shown here.
 *
 * noindex + excluded from the sitemap (astro.config.mjs): it's a tool for
 * the people building the site, not a page for visitors.
 */
import { getImage, Image } from 'astro:assets';
import contourWaves from '@/assets/img/brand/golden-contour-waves.png';
import seigaihaArt from '@/assets/img/brand/seigaiha.png';
import { palette } from '@/lib/palette';
import { textures } from '@/lib/textures';
import { catalog } from '@/lib/components';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocSection from '@/components/design/DocSection.astro';
import Specimen from '@/components/design/Specimen.astro';
import DesignNav from '@/components/design/DesignNav.astro';
import BlockRenderer from '@/components/BlockRenderer.astro';
import ImpactPlayground from '@/components/design/ImpactPlayground.astro';

// Brand primitives
import Icon from '@/components/brand/Icon.astro';
import RuyiCloud from '@/components/brand/RuyiCloud.astro';
import TerracedDivider from '@/components/brand/TerracedDivider.astro';
import MascotMark from '@/components/brand/MascotMark.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Lantern from '@/components/brand/Lantern.astro';
import RiceTerraces from '@/components/brand/RiceTerraces.astro';
import CloudCorner from '@/components/brand/CloudCorner.astro';
import Badge from '@/components/brand/Badge.astro';

// Components
import Button from '@/components/Button.astro';
import Pill from '@/components/ui/Pill.astro';
import Toast from '@/components/Toast.astro';
import CookieConsent from '@/components/CookieConsent.tsx';
import ProfileCard from '@/components/ProfileCard.astro';
import { memberLinks } from '@/lib/team';
import SponsorBand from '@/components/SponsorBand.astro';
import TeamStatsWidget from '@/components/TeamStatsWidget.astro';
import { getTeamWidgets } from '@/lib/pblidb';
import EventCard from '@/components/EventCard.astro';
import EventFees from '@/components/EventFees.astro';
import EventSquads from '@/components/EventSquads.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import SeasonStrip from '@/components/SeasonStrip.astro';
import BrandRule from '@/components/brand/BrandRule.astro';
import EventsCalendar from '@/components/EventsCalendar.astro';
import AgendaList from '@/components/AgendaList.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import StatNumber from '@/components/StatNumber.astro';
import Callout from '@/components/Callout.astro';
import MascotCallout from '@/components/MascotCallout.astro';
import VideoPlayer from '@/components/VideoPlayer.astro';
import CtaStrip from '@/components/CtaStrip.astro';
import ThreeColumn from '@/components/ThreeColumn.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import Gallery from '@/components/Gallery.astro';
import LogoStrip from '@/components/LogoStrip.astro';
import Ticker, { type TickerItem } from '@/components/Ticker.astro';
import Slideshow, { type Slide } from '@/components/Slideshow.tsx';
import FeatureRow from '@/components/marketing/FeatureRow.astro';
import ImpactBand from '@/components/marketing/ImpactBand.astro';
import TwoColumn from '@/components/TwoColumn.astro';
import PricingCard from '@/components/marketing/PricingCard.astro';
import ProductGrid from '@/components/marketing/ProductGrid.astro';
import FormField from '@/components/form/FormField.astro';
import RadioGroup from '@/components/form/RadioGroup.astro';
import CheckboxGroup from '@/components/form/CheckboxGroup.astro';
import CountryCombobox from '@/components/form/CountryCombobox.tsx';
import ChecklistDropdown from '@/components/form/ChecklistDropdown.tsx';
import PostCard from '@/components/blog/PostCard.astro';
import PostTeaser from '@/components/blog/PostTeaser.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import LatestPosts from '@/components/blog/LatestPosts.astro';
import BlogFilters from '@/components/blog/BlogFilters.astro';
import SiteSearch from '@/components/SiteSearch.tsx';
import { latestPosts, type PostSummary } from '@/lib/posts';

import { getEvents } from '@/lib/events';
import { site } from '@/lib/settings';
import { monthDay } from '@/lib/format';
import { strokedIconNames, filledIconNames } from '@/lib/icons';
import type { CloudVariant } from '@/lib/clouds';
import type { TerracedStyle } from '@/components/brand/TerracedDivider.astro';

import jerseyImg from '@/assets/img/leftovers-v1-v2.png';
import bcaImg from '@/assets/img/bca-leftover.jpg';
import logoImg from '@/assets/img/brand/logo.png';
import shooterImg from '@/assets/img/events/nxl-wc25/lo2nxlwc25-94-x5.webp';
import aimingImg from '@/assets/img/events/nxl-lso26/lo2nxllso26-219-x5.webp';
import sprintImg from '@/assets/img/events/nxl-lso26/lo3nxllso26-51-x5.webp';
import nxlUsLogo from '@/assets/img/leagues/nxl-us.png';
import nxlEuLogo from '@/assets/img/leagues/nxl-eu.png';
import icplLogo from '@/assets/img/leagues/icpl.png';
import infamousLogo from '@/assets/img/sponsors/infamous-paintball.png';
import kineticLogo from '@/assets/img/sponsors/kinetic-paintball.png';

// ---------------------------------------------------------------- data --
const [members, faqs, products, { upcoming, past, next }] = await Promise.all([
  getCollection('team'),
  getCollection('faqs'),
  getCollection('products'),
  getEvents(),
]);

const teamWidgets = (await getTeamWidgets()).slice(0, 3);
const sampleMember = members.sort((a, b) => a.data.order - b.data.order)[0];
const allEvents = [...upcoming, ...past];
const sampleEvent = next ?? upcoming[0] ?? past[0];
const samplePast = past[0];
const feeEvent = allEvents.find((event) => event.data.fees.length > 0);
const squadEvent = samplePast ?? sampleEvent;
const sampleFaqs = faqs.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

// Ticker lines from real collections: upcoming events, the next one flagged.
// Falls back to recent events if none are upcoming.
const tickerItems: TickerItem[] = [
  ...(upcoming.length ? upcoming : past.slice(0, 3)).slice(0, 4).map((e, i) => ({
    kicker: upcoming.length && i === 0 ? 'Next up' : undefined,
    label: `${e.data.title} · ${monthDay(e.data.startDate)}${e.data.location ? ` · ${e.data.location.city}` : ''}`,
    href: `/events#${e.id}`,
  })),
];

// Slides for the carousel variants — local assets only (the CSP is
// img-src 'self'), resolved through the image service like GallerySlideshow.
const slideSources = [
  { src: bcaImg, alt: 'Pink breast-cancer-awareness Leftovers jersey', caption: 'Series Finals — Day 1', kicker: 'Specimen kicker' },
  { src: jerseyImg, alt: 'V1 and V2 Leftovers jerseys side by side', caption: 'Series Finals — Nov 14–15', kicker: 'Specimen kicker' },
  { src: logoImg, alt: 'The Leftovers logo lockup', caption: 'Pre-order drop', kicker: undefined },
];
// Real event photography for the full-bleed showcase specimen.
const showcaseSources = [
  { src: shooterImg, alt: 'A Leftovers player aims a paintball marker across a field.', caption: 'Eyes up', kicker: 'NXL · 2025' },
  { src: sprintImg, alt: 'Three Leftovers players sprint out from behind a red inflatable bunker.', caption: 'Full send', kicker: 'NXL · 2026' },
  { src: aimingImg, alt: 'A Leftovers player behind an inflatable bunker sights down a marker.', caption: 'Hold the lane', kicker: 'NXL · 2026' },
];
const showcaseSlides: Slide[] = await Promise.all(
  showcaseSources.map(async ({ src, alt, caption, kicker }) => {
    const optimized = await getImage({ src, widths: [640, 960, 1440, 1920], format: 'webp' });
    return {
      src: optimized.src,
      srcSet: optimized.srcSet.attribute || undefined,
      width: Number(optimized.attributes.width ?? src.width),
      height: Number(optimized.attributes.height ?? src.height),
      alt,
      caption,
      kicker,
    };
  })
);
const slides: Slide[] = await Promise.all(
  slideSources.map(async ({ src, alt, caption, kicker }) => {
    const optimized = await getImage({ src, widths: [480, 768, 1200], format: 'webp' });
    return {
      src: optimized.src,
      srcSet: optimized.srcSet.attribute || undefined,
      width: Number(optimized.attributes.width ?? src.width),
      height: Number(optimized.attributes.height ?? src.height),
      alt,
      caption,
      kicker,
    };
  })
);

// Blog specimens use the real published posts once there are three; until
// then, clearly labelled specimen posts on real event photos. Links point
// back at this section, so nothing here leads to a page that doesn't exist.
const realPosts = await latestPosts(3);
const specimenPosts: PostSummary[] = [
  {
    id: 'specimen-1', href: '#blog', title: 'Specimen post: a featured recap',
    summary: 'The summary field: one or two sentences, shown on cards and as the meta description.',
    publishDate: new Date('2026-11-16'), updatedDate: new Date('2026-11-18'),
    author: { name: 'Author Name', role: 'Role' }, category: { id: 'recap', label: 'Recap' },
    tags: ['Bushball', 'Specimen'], cover: shooterImg, coverAlt: 'A Leftovers player aims a paintball marker across a field.',
    readingMinutes: 4, featured: true,
  },
  {
    id: 'specimen-2', href: '#blog', title: 'Specimen post: an announcement',
    summary: 'A second specimen with a cover photo, for the grid card.',
    publishDate: new Date('2026-10-02'), category: { id: 'news', label: 'News' }, tags: ['Specimen'], cover: sprintImg,
    coverAlt: 'Three Leftovers players sprint out from behind a red inflatable bunker.', readingMinutes: 2, featured: false,
  },
  {
    id: 'specimen-3', href: '#blog', title: 'Specimen post: no cover photo',
    summary: 'Without a cover, the card falls back to the topo texture and the mascot.',
    publishDate: new Date('2026-09-14'), category: { id: 'gear', label: 'Gear' }, tags: [], coverAlt: 'Specimen post: no cover photo', readingMinutes: 1, featured: false,
  },
];
const blogSamples = realPosts.length >= 3 ? realPosts : specimenPosts;

// ------------------------------------------------------------- catalog --

const cloudVariants: CloudVariant[] = [1, 2, 3, 4, 5, 6];
const terracedStyles: { style: TerracedStyle; label: string; note: string }[] = [
  { style: 'rice-terrace', label: 'rice-terrace (default)', note: 'Flat stepped plateaus. Card footers and full-width section breaks.' },
  { style: 'pagoda', label: 'pagoda', note: 'Curved eaves with finial dots. The one-per-page flourish (homepage hero).' },
  { style: 'refined-peaks', label: 'refined-peaks', note: "Closest to the old skyline's footprint, with round joins and hex glyphs." },
];

/**
 * The component index renders from the catalog in src/lib/components.ts
 * (also the source of docs/COMPONENTS.md). Add a component there, not here.
 */
const index = catalog;

/**
 * The page's sections, grouped for the side nav (DesignNav). ADD A ROW when
 * you add a <DocSection>, in page order. Section numbers come from this
 * order (num()), so they never skip or need renumbering. Specimens are
 * listed under their section automatically.
 */
const navGroups = [
  {
    label: 'Brand',
    sections: [
      { id: 'foundations', label: 'Foundations' },
      { id: 'motifs', label: 'Motifs' },
      { id: 'motion', label: 'Motion' },
      { id: 'icons', label: 'Icons' },
    ],
  },
  {
    label: 'Components',
    sections: [
      { id: 'components', label: 'Components' },
      { id: 'blocks', label: 'Page blocks' },
      { id: 'marketing', label: 'Marketing' },
      { id: 'forms', label: 'Forms' },
      { id: 'calendar', label: 'Calendar' },
      { id: 'blog', label: 'Blog' },
      { id: 'imagery', label: 'Imagery' },
    ],
  },
  { label: 'Reference', sections: [{ id: 'index', label: 'Component index' }] },
];
const order = navGroups.flatMap((g) => g.sections.map((s) => s.id));
const num = (id: string) => {
  const i = order.indexOf(id);
  if (i < 0) throw new Error(`design.astro: add section "${id}" to navGroups`);
  return String(i + 1).padStart(2, '0');
};
const nav = navGroups.map((g) => ({ ...g, sections: g.sections.map((sec) => ({ ...sec, number: num(sec.id) })) }));

const threeColItems: { icon: 'jersey' | 'calendar' | 'trophy'; title: string; body: string }[] = [
  { icon: 'jersey', title: 'Bring your own gear', body: 'Your marker, mask and pods. No loaners.' },
  { icon: 'calendar', title: 'Pick your events', body: 'Confirm the dates you can make. No season commitment.' },
  { icon: 'trophy', title: 'Play real points', body: 'No bench. Everyone on the roster plays.' },
];

const positions = ['Wherever you need me', 'Front', 'Mid', 'Back', 'Snake', 'Insert'];

const specimenVideo = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order)[0];

const landingHome = (await getCollection('landing')).find((page) => page.id === 'home');
const blockSpecimen = landingHome?.data.sections.slice(-2) ?? [];
---

<BaseLayout
  title="Design System"
  description="The Leftovers design system: tokens, motifs, icons and every production component, rendered live."
  noindex
>
  <div class="bg-[#EFEBE0] text-[#1a1712]">
    {/* ---------------------------------------------------------- top bar */}
    <div class="design-topbar border-b-2 border-gold bg-ink">
      <div class="mx-auto flex max-w-[1320px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3.5 sm:px-6">
        <p class="flex items-center gap-2.5">
          <span class="font-marker text-[1.375rem] tracking-[0.02em] text-brand-red">The Leftovers</span>
          <span class="text-[0.6875rem] text-tan" aria-hidden="true">/</span>
          <span class="font-display text-sm uppercase tracking-[0.06em] text-bone">Design Storybook</span>
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-[1600px] lg:grid lg:grid-cols-[240px_minmax(0,1fr)]">
    <DesignNav groups={nav} />
    {/* Phone preview stage (DesignNav fills it with an iframe on demand). */}
    <div class="design-phone sticky top-[var(--site-header,65px)] h-[calc(100vh-var(--site-header,65px))] py-6" hidden>
      <div class="mx-auto flex h-[calc(100%-1.5rem)] w-[406px] flex-col rounded-[2.25rem] border-[8px] border-ink bg-ink shadow-2xl shadow-ink/30">
        <div class="design-phone-screen min-h-0 flex-1 overflow-hidden rounded-[1.75rem]"></div>
      </div>
      <p class="mt-2 text-center font-mono text-[0.625rem] text-[#6b6356]">390 px · same page, real phone breakpoints</p>
    </div>
    <div class="design-main min-w-0">
    {/* ------------------------------------------------------------ intro */}
    <div class="mx-auto max-w-[1320px] px-4 pb-8 pt-12 sm:px-6">
      <p class="mb-2.5 text-[0.6875rem] font-bold uppercase tracking-[0.22em] text-crimson">
        Design system &amp; component reference
      </p>
      <h1 class="mb-4 text-[clamp(2rem,5vw,3.5rem)] text-ink">Design System Storybook</h1>
      <p class="max-w-[720px] text-base leading-relaxed text-[#4a443a]">
        Every specimen on this page is the production component, rendered with real content from
        <code class="rounded-[3px] bg-[#e2ddce] px-1.5 py-0.5 text-sm">src/content</code>. Tokens come from
        <code class="rounded-[3px] bg-[#e2ddce] px-1.5 py-0.5 text-sm">src/styles/global.css</code>. Build new
        pages from what's here; when you add a component, add its specimen and an index row. Interactive React
        islands also have stories in Storybook (<code class="rounded-[3px] bg-[#e2ddce] px-1.5 py-0.5 text-sm">npm run storybook</code>).
      </p>
    </div>

    {/* ====================================================== FOUNDATIONS */}
    <DocSection id="foundations" number={num('foundations')} title="Foundations" kicker="Locked: tokens live in global.css @theme">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <Specimen
          title="Color palette"
          surface="paper"
          class="md:col-span-2"
          file="src/styles/global.css"
          note="Crimson on ink is 2.2:1, which fails AA, so every accent is split into a FILL hex and a lighter TEXT hex (crimson → crimson-400, gold → gold-300). Carry the same split into any new component. Never type a raw hex in a component; use the Tailwind token (bg-ink-800, text-gold-300)."
        >
          <ul class="grid grid-cols-3 gap-2.5 sm:grid-cols-6">
            {palette.map((c) => (
              <li>
                <div class:list={['h-14 border border-[#DAD4C4]', c.swatch]} />
                <p class="mt-1.5 font-mono text-[0.625rem]">{c.hex}</p>
                <p class="text-[0.625rem] font-bold text-[#3a342b]">{c.name}</p>
                <p class="text-[0.625rem] text-[#6b6356]">{c.role}</p>
              </li>
            ))}
          </ul>
        </Specimen>

        <Specimen title="Gold ribbed numeral" note="Not a font: a gradient + repeating ribs clipped to text. Use the .numeral class on Gasoek One digits only.">
          <div class="flex flex-col items-center justify-center py-4">
            <span class="numeral text-[5.625rem] leading-[0.9]">22</span>
            <code class="mt-3 font-mono text-[0.6875rem] text-gold-300">class="numeral"</code>
          </div>
        </Specimen>

        <Specimen
          title="Typography: roles & header options"
          surface="paper"
          class="md:col-span-2 xl:col-span-3"
          note="CC Monster Mash Worn is reserved strictly for the logo/wordmark. Headings h1–h4 get Gasoek One uppercase from the base layer. Use .title-sm for any heading under 24px, and .eyebrow for kicker labels above headlines."
        >
          <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
            <div>
              <p class="font-marker text-[2.375rem] leading-none text-brand-red">The Leftovers</p>
              <p class="mt-1.5 text-[0.6875rem] text-[#6b6356]">CC Monster Mash Worn · <code>font-marker</code>. Logo &amp; wordmark only, licensed, never headings or body text.</p>
            </div>
            <div>
              <p class="font-display text-[1.875rem] uppercase leading-none text-ink">Meet the Crew</p>
              <p class="mt-1.5 text-[0.6875rem] text-[#6b6356]">Gasoek One · <code>font-display</code>. Every heading, uppercase, tight leading. Wide and heavy: keep headlines short.</p>
            </div>
            <div>
              <h4 class="title-sm text-[#1a1712]">Request a spot</h4>
              <p class="mt-1.5 text-[0.6875rem] text-[#6b6356]">Inter bold · <code>title-sm</code>. Any heading under 24px, where the headline font fills in.</p>
            </div>
            <div>
              <p class="font-sans text-base text-[#1a1712]">Paintball builds better people. Aa Bb Cc 123</p>
              <p class="mt-1.5 text-[0.6875rem] text-[#6b6356]">Inter · <code>font-sans</code>. Body &amp; UI text, 400–700.</p>
            </div>
          </div>
        </Specimen>
      </div>
    </DocSection>

    {/* =========================================================== MOTIFS */}
    <DocSection id="motifs" number={num('motifs')} title="Motifs" kicker="Ruyi cloud · terraced trim · textures · brand marks">
      <div class="grid gap-5">
        <Specimen
          title="Ruyi cloud: 6 licensed variants"
          file={['src/components/brand/RuyiCloud.astro', 'src/lib/clouds.ts']}
          note="Coloured by currentColor, so set it with a text-* class. Use 10–20% opacity as a background/corner accent, ~90% as a hero accent. Vary variant/flip so repeated sections don't look stamped. Attribution is required: it lives on /credits, linked from every page footer. Never remove either."
        >
          <div class="flex flex-wrap items-center gap-6">
            {cloudVariants.map((v, i) => (
              <div class="flex flex-col items-center gap-1.5">
                <RuyiCloud
                  variant={v}
                  class:list={['h-14 w-auto', ['text-crimson', 'text-gold', 'text-bone/50'][i % 3]]}
                />
                <code class="font-mono text-[0.625rem] text-bone-muted">variant={v}</code>
              </div>
            ))}
          </div>
        </Specimen>

        <Specimen
          title="BrandRule: themed horizontal rule"
          file="src/components/brand/BrandRule.astro"
          note={'Use it to split up content inside a section or give stacked components some air. peaks closes cards, field is the quietest, cloud marks a bigger break. spacing sets the gap: none, sm, md or lg.'}
        >
          <div class="flex flex-col gap-6 bg-ink-800 p-6">
            <BrandRule ornament="peaks" spacing="none" />
            <BrandRule ornament="field" spacing="none" />
            <BrandRule ornament="cloud" spacing="none" />
          </div>
        </Specimen>

        <Specimen
          title="Terraced mountain trim: 3 styles × 2 variants"
          file="src/components/brand/TerracedDivider.astro"
          note={'variant="full" draws the forest silhouette + gold ridge; variant="line" is stroke only, for use over an already-coloured surface. Keep it tall: it stretches to fit, so use BrandRule in thin spaces. seed varies the ridge so two dividers on a page differ; flip points it downward.'}
        >
          <div class="grid gap-6 lg:grid-cols-3">
            {terracedStyles.map(({ style, label, note }) => (
              <div>
                <p class="mb-1.5 text-[0.625rem] font-bold uppercase tracking-[0.12em] text-gold-300">{label}</p>
                <TerracedDivider style={style} class="h-[90px] bg-ink-900" />
                <TerracedDivider style={style} variant="line" seed={3} class="mt-2 h-8 bg-ink-800" />
                <p class="mt-1.5 text-[0.6875rem] text-bone-muted">{note}</p>
              </div>
            ))}
          </div>
        </Specimen>

        <Specimen
          title="Background textures"
          file={['src/lib/textures.ts', 'src/styles/global.css', 'scripts/make-pattern-tiles.mjs']}
          note={'Each texture is a CSS utility backed by an SVG tile. "text-safe" ones can sit behind body text (or use <Section tone="topo|sand|seigaiha">). "decorative" ones never go under text. To change sand or seigaiha, edit the script and re-run node scripts/make-pattern-tiles.mjs. To add one, add a row to src/lib/textures.ts.'}
        >
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {textures.map((t) => (
              <div>
                <div class:list={[t.className, 'h-40 border border-ink-600']} />
                <p class="mt-1.5 flex flex-wrap items-center gap-1.5">
                  <code class="font-mono text-[0.625rem] text-gold-300">.{t.className}</code>
                  <Pill tone={t.textSafe ? 'forest' : 'muted'} size="sm">{t.textSafe ? 'text-safe' : 'decorative'}</Pill>
                </p>
                <p class="mt-1 text-[0.625rem] leading-snug text-bone-muted">{t.use}</p>
              </div>
            ))}
          </div>
        </Specimen>

        <Specimen
          title="Source art: one-off images"
          file={['src/assets/img/brand/golden-contour-waves.png', 'src/assets/img/brand/seigaiha.png']}
          note={'The original artwork the tiles were derived from. Use via <Image> for a single hero or feature panel, never as a repeating background. seigaiha.png is white on transparent, so it works over any fill (crimson shown) and can be tinted down with opacity.'}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <Image
                src={contourWaves}
                alt=""
                widths={[480, 960]}
                sizes="(min-width: 640px) 50vw, 100vw"
                class="h-52 w-full border border-ink-600 object-cover"
              />
              <code class="mt-1.5 block font-mono text-[0.625rem] text-bone-muted">golden-contour-waves.png</code>
            </div>
            <div>
              <div class="h-52 overflow-hidden border border-ink-600 bg-crimson">
                <Image
                  src={seigaihaArt}
                  alt=""
                  widths={[480, 960]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover opacity-30"
                />
              </div>
              <code class="mt-1.5 block font-mono text-[0.625rem] text-bone-muted">seigaiha.png · on bg-crimson, opacity-30</code>
            </div>
          </div>
