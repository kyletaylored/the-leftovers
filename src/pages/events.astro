---
/**
 * /events — what's next, how to get on a squad, and the record so far.
 *
 * Nov 2026 rework. The team plays about one event a month at most, so the
 * month-grid calendar was replaced by one SeasonStrip per year, sitting above
 * that year's results (see docs/PRD-CONFORMANCE.md). Only the newest season
 * starts open: every older one is a native <details>, because most visitors
 * are on phones and a full record stacks into a very long page.
 *
 * Only events with a location get a SportsEvent node: Google requires one,
 * and a node without it is a Search Console error, not a partial result.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { resolveHeroImages } from '@/lib/images';
import Section from '@/components/Section.astro';
import EventCard from '@/components/EventCard.astro';
import EventFees from '@/components/EventFees.astro';
import EventSquads from '@/components/EventSquads.astro';
import MascotCallout from '@/components/MascotCallout.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import SeasonStrip from '@/components/SeasonStrip.astro';
import Button from '@/components/Button.astro';
import Countdown from '@/components/Countdown.astro';
import BrandRule from '@/components/brand/BrandRule.astro';
import Icon from '@/components/brand/Icon.astro';
import { fullTitle, getEvents, seasonOf } from '@/lib/events';
import { isoDate } from '@/lib/format';
import { site } from '@/lib/settings';
import { recapsByEvent } from '@/lib/posts';

const page = await getEntry('pages', 'events');
if (!page) throw new Error('Missing content file: src/content/pages/events.md');
const heroImages = await resolveHeroImages(page.data.heroImages);

const { all, upcoming, past, next } = await getEvents();
// Event id → its recap post, so past EventCards can link to it.
const recaps = await recapsByEvent();
const later = upcoming.slice(1);
const feeEvent = [...upcoming, ...past].find((event) => event.data.fees.length > 0);
const seasons = [...new Set(all.map(seasonOf))].sort((a, b) => b - a);

const schema = upcoming.flatMap((event) => {
  const { league, location, startDate, endDate, eventUrl } = event.data;
  if (!location) return [];
  const name = [league, fullTitle(event)].filter(Boolean).join(' ');
  return [
    {
      '@type': 'SportsEvent',
      name,
      description: `The Leftovers paintball team at ${name} in ${location.city}.`,
      url: new URL(`/events#${event.id}`, Astro.site).href,
      image: new URL('/og-default.png', Astro.site).href,
      startDate: isoDate(startDate),
      endDate: isoDate(endDate ?? startDate),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: location.venue,
        address: {
          '@type': 'PostalAddress',
          ...(location.street ? { streetAddress: location.street } : {}),
          addressLocality: location.city,
          ...(location.region ? { addressRegion: location.region } : {}),
          ...(location.postalCode ? { postalCode: location.postalCode } : {}),
          addressCountry: location.country,
        },
      },
      ...(league ? { organizer: { '@type': 'Organization', name: league } } : {}),
      competitor: { '@id': new URL('/#team', Astro.site).href },
      ...(eventUrl ? { sameAs: eventUrl } : {}),
    },
  ];
});
---

<BaseLayout
  noindex={page.data.seo.noindex}
  title={page.data.seo.title ?? page.data.title}
  description={page.data.seo.description}
  schema={schema}
>
  <PageHeader
    eyebrow={page.data.eyebrow}
    title={page.data.title}
    intro={page.data.intro}
    images={heroImages}
  />

  <Section tone="alt" title={next ? 'Next up' : 'On the calendar'}>
    {
      next ? (
        <>
          <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
            <div class="flex flex-col gap-6">
              <div class="rounded-sm border border-gold/40 bg-ink-800 p-5 sm:p-6">
                <p class="eyebrow mb-3">Starts in</p>
                <Countdown target={next.data.startDate} />
              </div>
              <EventCard event={next} as="h3" layout="feature" />
            </div>

            {next.data.squads.length > 0 && (
              <div class="rounded-sm border border-ink-600 bg-ink-800 p-5 sm:p-6">
                <h3 class="text-2xl text-bone">{next.data.squads.length} squads on the entry list</h3>
                <p class="mb-5 mt-1 text-sm text-bone-muted">As listed by the league. Squads can still change before the event.</p>
                <EventSquads squads={next.data.squads} columns={2} />
              </div>
            )}
          </div>

          {later.length > 0 && (
            <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {later.map((event) => (
                <li class="flex">
                  <EventCard event={event} class="w-full" recapHref={recaps.get(event.id)} />
                </li>
              ))}
            </ul>
          )}
        </>
      ) : (
        <MascotCallout
          title="Nothing scheduled yet"
          body="Next season's dates haven't dropped. Send a join request and we'll follow up as soon as one's on the calendar."
        >
          <Button href="/join" size="sm">Send a join request</Button>
        </MascotCallout>
      )
    }
  </Section>

  <Section tone="base" eyebrow="How it works" title="From request to the field">
    <ProcessSteps steps={site.eventProcess.steps} />
    <div class="mt-8">
      <Button href="/join">Request a spot</Button>
    </div>

    {
      feeEvent && (
        <>
          <BrandRule ornament="field" spacing="lg" />
          <h3 class="mb-2 text-2xl text-bone sm:text-3xl">What events cost</h3>
          <p class="mb-6 max-w-3xl text-sm leading-relaxed text-bone-muted sm:text-base">
            Every event prices its formats and divisions differently. Here's {fullTitle(feeEvent)} for the divisions we entered.
          </p>
          <EventFees event={feeEvent} note={site.eventProcess.feeNote} />
        </>
      )
    }
  </Section>

  <Section tone="alt" eyebrow="The record" title="Season by season">
    {
      seasons.map((year, index) => {
        const played = past.filter((event) => seasonOf(event) === year);
        const body = (
          <>
            <SeasonStrip events={all} year={year} class="mb-8" />
            {played.length > 0 && (
              <ul class="grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {played.map((event) => (
                  <li>
                    <EventCard event={event} as="h4" recapHref={recaps.get(event.id)} />
                  </li>
                ))}
              </ul>
            )}
          </>
        );
        return index === 0 ? (
          <>
            <h3 class="mb-5 text-2xl text-bone sm:text-3xl">{year}</h3>
            {body}
          </>
        ) : (
          <>
            <BrandRule ornament="cloud" spacing="lg" />
            <details class="group/season">
              <summary class="tap flex cursor-pointer list-none items-center gap-3 [&::-webkit-details-marker]:hidden">
                <h3 class="text-2xl text-bone sm:text-3xl">{year}</h3>
                <span class="text-sm text-gold-300 underline underline-offset-4">
                  {played.length} {played.length === 1 ? 'event' : 'events'}
                </span>
                <Icon name="chevron" class="size-4 text-gold-300 transition-transform group-open/season:rotate-180" />
              </summary>
              <div class="mt-5">{body}</div>
            </details>
          </>
        );
      })
    }
  </Section>
</BaseLayout>
