---
/**
 * BaseLayout — the single HTML shell every page renders inside.
 *
 * Head order is deliberate: preconnects and fonts first (fonts are the only
 * blocking external resource on the site), then metadata. Astro's font API
 * self-hosts the files, emits `font-display: swap`, and preloads only the
 * faces used above the fold — the launch requirement in §10.2.
 */
import { Font } from 'astro:assets';
import '@/styles/global.css';
import { site } from '@/lib/settings';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import SponsorBand from '@/components/SponsorBand.astro';
import Seo from '@/components/Seo.astro';
import CookieConsent from '@/components/CookieConsent.tsx';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Array<Record<string, unknown>>;
  /** Drop the nav's sticky offset padding for full-bleed hero pages. */
  bodyClass?: string;
}

const { bodyClass = '', ...seo } = Astro.props;

// Datadog RUM is on only when both public IDs are set (see datadog-rum.ts).
const rum = site.datadogRum;
const rumEnabled = Boolean(rum.applicationId && rum.clientToken);
const rumConfig = rumEnabled
  ? JSON.stringify({
      ...rum,
      // The deployed commit (set by GitHub Actions), so Datadog can tell deploys apart.
      version: process.env.GITHUB_SHA?.slice(0, 7) || undefined,
    }).replace(/</g, '\\u003c')
  : '';
// The consent banner is needed if any consent-gated analytics is configured.
const needsConsent = Boolean(site.gtmId) || rumEnabled;

/** Emitted on every page so the team itself is one crawlable entity. */
const organizationSchema = {
  '@type': 'SportsTeam',
  '@id': new URL('/#team', Astro.site).href,
  name: site.title,
  sport: 'Paintball',
  description: site.description,
  url: new URL('/', Astro.site).href,
  // A square logo for the entity; the wide share card is its `image`.
  logo: new URL('/img/leftovers-logo.png', Astro.site).href,
  image: new URL('/og-default.png', Astro.site).href,
  ...(site.established ? { foundingDate: String(site.established) } : {}),
  ...(site.homeBase ? { areaServed: site.homeBase } : {}),
  email: site.social.email,
  sameAs: [
    site.social.instagram,
    site.social.facebookGroup,
    site.social.youtube,
    site.social.tiktok,
  ].filter(Boolean),
};
---

<!doctype html>
<html lang="en" class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B0A08" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    {/* iOS ignores SVG touch icons; the 180×180 PNG is what it uses. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-headline" preload />
    <Font cssVariable="--font-body" preload />
    {/* Deliberately NOT preloaded. Be aware this helps less than it seems:
        the nav wordmark is above the fold, so the browser still fetches this
        face at VeryHigh priority while building first paint (measured in
        Lighthouse's network log). Not preloading avoids adding a second
        competing high-priority hint alongside the hero logo, but it does not
        move the font off the critical path. See ATTRIBUTIONS.md. */}
    <Font cssVariable="--font-brush" />

    <Seo {...seo} schema={[organizationSchema, ...(seo.schema ?? [])]} />

    {
      site.gtmId && (
        <script is:inline define:vars={{ gtmId: site.gtmId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          var storedConsent = null;
          try {
            storedConsent = window.localStorage.getItem('leftovers_cookie_consent');
          } catch (e) {}
          gtag('consent', 'default', {
            analytics_storage: storedConsent === 'accepted' ? 'granted' : 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          gtag('js', new Date());
          if (storedConsent === 'accepted') {
            window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
            s.dataset.gtmId = gtmId;
            document.head.appendChild(s);
          }
        </script>
      )
    }
    {
      rumEnabled && (
        <>
          <script type="application/json" id="datadog-rum-config" set:html={rumConfig} />
          <script>
            import '@/scripts/datadog-rum';
          </script>
        </>
      )
    }
  </head>

  {/* Above FRAME_MAX (src/lib/layout.ts) the site sits in a centred frame
      over the textured surround; below it the frame is just the page. */}
  <body class:list={['site-surround', bodyClass]}>
    <div class="site-frame flex min-h-dvh flex-col">
      <Nav />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <SponsorBand />
      <Footer />
    </div>
    {needsConsent && <CookieConsent gtmId={site.gtmId} client:visible />}
  </body>
</html>
