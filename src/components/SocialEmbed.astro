---
/**
 * SocialEmbed — wraps whichever third-party widget script §8.3 settles on.
 *
 * Three realities this component encodes, so no page has to re-learn them:
 *  - Facebook: §8.3 ruled out an embedded feed because the team was assumed
 *    to run a GROUP, and Groups cannot be embedded by anyone. The team's
 *    presence is actually a PAGE (facebook.com/leftoverspb), and Meta's Page
 *    Plugin does embed Pages — so this renders the real feed when
 *    `facebookPagePlugin.enabled` is set, and the link-out card otherwise.
 *    It defaults to OFF because the plugin loads Meta's SDK and sets
 *    cookies, which would contradict the footer's "no trackers" claim.
 *  - Instagram has no casual live-feed API, so a grid needs a third-party
 *    aggregator's script. Until one is configured in site settings, this
 *    renders the link-out fallback instead of an empty hole.
 *  - Discord ships an official, free widget for public servers — the one
 *    embed here that costs nothing and needs no third party.
 *
 * Third-party scripts are loaded lazily and only when configured, so an
 * unconfigured widget can never cost the page a Core Web Vital (§10.2).
 */
import { site } from '@/lib/settings';
import Button from './Button.astro';
import MascotCallout from './MascotCallout.astro';

interface Props {
  network: 'instagram' | 'discord' | 'facebook';
  title?: string;
  class?: string;
}
const { network, title, class: className = '' } = Astro.props;

const widget = site.instagramWidget;
const instagramReady = Boolean(widget.scriptSrc && widget.elementClass);
const discordReady = Boolean(site.discordServerId);
const facebookReady = Boolean(site.facebookPagePlugin.enabled && site.facebookPagePlugin.pageUrl);
---

<div class:list={[className]}>
  {
    network === 'instagram' &&
      (instagramReady ? (
        <>
          <div class={widget.elementClass} />
          <script is:inline async src={widget.scriptSrc} />
        </>
      ) : (
        <MascotCallout
          as="h3"
          title="Feed coming soon"
          body="Instagram has no live-feed API for casual use, so the grid runs through a widget provider's free tier. Until that's wired up, the real feed lives on Instagram."
        >
          <Button href={site.social.instagram} external variant="outline" size="sm">
            Follow @theleftovers on Instagram
          </Button>
        </MascotCallout>
      ))
  }

  {
    network === 'discord' &&
      (discordReady ? (
        <iframe
          src={`https://discord.com/widget?id=${site.discordServerId}&theme=dark`}
          title={title ?? 'The Leftovers Discord server'}
          width="100%"
          height="420"
          loading="lazy"
          sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
          class="rounded-sm border border-ink-600"
        />
      ) : (
        <MascotCallout
          as="h3"
          title="Jump in the Discord"
          body="Discord is where the next tournament's squad actually gets sorted out — who's in, who's carrying what, who's driving."
        >
          <Button href={site.social.discord} external size="sm">
            Open the Discord invite
          </Button>
        </MascotCallout>
      ))
  }

  {
    network === 'facebook' &&
      (facebookReady ? (
        <>
          <div
            class="fb-page w-full"
            data-href={site.facebookPagePlugin.pageUrl}
            data-tabs="timeline"
            data-width="500"
            data-height="640"
            data-small-header="false"
            data-adapt-container-width="true"
            data-hide-cover="false"
            data-show-facepile="true"
          >
            <blockquote cite={site.facebookPagePlugin.pageUrl} class="fb-xfbml-parse-ignore">
              <a href={site.facebookPagePlugin.pageUrl} rel="noopener">The Leftovers on Facebook</a>
            </blockquote>
          </div>
          <script
            is:inline
            async
            defer
            crossorigin="anonymous"
            src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v21.0"
          />
        </>
      ) : (
        <MascotCallout
          as="h3"
          title="The Facebook page"
          body="Photo dumps, post-tournament arguing and local field chatter. The embedded feed is switched off so the site stays cookie-free — this is the door to it."
        >
          <Button href={site.social.facebookGroup} external size="sm" variant="outline">
            Follow The Leftovers on Facebook
          </Button>
        </MascotCallout>
      ))
  }
</div>
