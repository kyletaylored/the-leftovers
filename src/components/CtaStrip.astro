---
/**
 * CtaStrip — the wide crimson banner (§7), used for the pre-order drop and
 * the "join the crew" push.
 */
import RuyiCloud from './brand/RuyiCloud.astro';

interface Props {
  title: string;
  eyebrow?: string;
  body?: string;
  tone?: 'crimson' | 'forest';
  as?: 'h2' | 'h3';
  class?: string;
}
const { title, eyebrow, body, tone = 'crimson', as: Heading = 'h2', class: className = '' } =
  Astro.props;
const tones = { crimson: 'bg-crimson', forest: 'bg-forest' } as const;
---

<div class:list={['relative overflow-hidden rounded-sm', tones[tone], className]}>
  <RuyiCloud
    variant={5}
    flip
    class="pointer-events-none absolute -right-10 -top-8 h-32 w-auto text-ink/25"
  />
  <div class="relative grid items-center gap-6 p-7 sm:p-10 lg:grid-cols-[1.4fr_1fr] lg:gap-10">
    <div>
      {eyebrow && <p class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.22em] text-gold-300">{eyebrow}</p>}
      <Heading class="text-3xl text-bone sm:text-4xl lg:text-5xl">{title}</Heading>
      {body && <p class="mt-3 max-w-xl text-sm leading-relaxed text-bone/90 sm:text-base">{body}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div class="lg:justify-self-end">
      <slot />
    </div>
  </div>
</div>
