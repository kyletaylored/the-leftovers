---
/**
 * EventCard — date badge, location, league tag, CTAs and a BrandRule footer
 * (§7 custom components). The badge sits top right, so everything else lines
 * up on the card's left edge, and it comes after the title in reading order.
 *
 * The CTAs switch on derived state (lib/events.ts). An upcoming event offers
 * "Request a spot", which goes to /join because the event captain registers
 * the team, until the event ends or the CMS closes it. A past event shows the best
 * finish and an expandable list of every squad. The list is a native
 * <details>, so it needs no JS.
 */
import { Image } from 'astro:assets';
import Icon from './brand/Icon.astro';
import BrandRule from './brand/BrandRule.astro';
import Button from './Button.astro';
import EventSquads from './EventSquads.astro';
import { resolveImage } from '@/lib/images';
import { dateRange, dayNum, dayOfWeek, monthShort, isoDate, ordinal } from '@/lib/format';
import { addressLine, bestFinish, fullTitle, isTakingRequests, isUpcoming, type EventEntry } from '@/lib/events';

interface Props {
  event: EventEntry;
  as?: 'h2' | 'h3' | 'h4';
  /** `feature` is the larger "NEXT UP" treatment on the homepage. */
  layout?: 'card' | 'feature';
  class?: string;
}

const { event, as: Heading = 'h3', layout = 'card', class: className = '' } = Astro.props;
// Lets the Calendar's day links (#slug) jump straight to this card.
const anchorId = event.id;
const { league, startDate, endDate, location, eventUrl, squads, cover, coverAlt, resultSummary, placement } =
  event.data;

const coverAsset = await resolveImage(cover);
const upcoming = isUpcoming(event);
const takingRequests = isTakingRequests(event);
const best = bestFinish(event);
const finish = placement ?? (best?.fieldSize && `${ordinal(best.place ?? 0)} of ${best.fieldSize}`);
const name = fullTitle(event);
const squadCount = `${squads.length} ${squads.length === 1 ? 'squad' : 'squads'}`;
---

<article
  id={anchorId}
  class:list={[
    'group relative flex scroll-mt-24 flex-col overflow-hidden rounded-sm border border-ink-600 bg-ink-800 transition-colors hover:border-gold/50 target:border-gold target:ring-2 target:ring-gold/50',
    className,
  ]}
>
  {
    coverAsset && (
      <div class="relative aspect-[16/9] overflow-hidden bg-ink-900">
        <Image
          src={coverAsset}
          alt={coverAlt ?? ''}
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 380px, 92vw"
          loading="lazy"
          decoding="async"
          class="size-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0"
        />
        {league && (
          <span class="absolute right-3 top-3 rounded-full bg-crimson px-3 py-1 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-bone">
            {league}
          </span>
        )}
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col p-5', layout === 'feature' && 'sm:p-7']}>
    <div class="flex items-start gap-4">
      <div class="min-w-0 flex-1">
        {
          league && !coverAsset && (
            <span class="mb-2 inline-block rounded-full bg-crimson px-2.5 py-0.5 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-bone">
              {league}
            </span>
          )
        }
        <Heading
          class:list={[
            'text-bone',
            layout === 'feature' ? 'text-3xl sm:text-4xl' : 'text-2xl',
          ]}
        >
          {name}
        </Heading>
        {
          location ? (
            <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-bone-muted">
              <Icon name="pin" class="size-4 shrink-0 text-gold" />
              <span>{location.venue}</span>
              {layout === 'card' && <span aria-hidden="true">·</span>}
              {layout === 'card' && <span>{[location.city, location.region].filter(Boolean).join(', ')}</span>}
            </p>
          ) : (
            <p class="mt-2 text-sm italic text-bone-muted">Venue to be confirmed</p>
          )
        }
        {layout === 'feature' && location && <p class="mt-1 text-sm text-bone-muted">{addressLine(location)}</p>}
        <p class="mt-1 text-sm text-bone-muted">
          <time datetime={isoDate(startDate)}>{dateRange(startDate, endDate)}</time>
        </p>
      </div>

      <!-- Date badge -->
      <div
        class="flex shrink-0 flex-col items-center rounded-sm border border-gold/50 bg-ink-900 px-3 py-2"
      >
        {/* Day-of-week added per the Sept 2026 design-handoff audit (delta
            #5) — dayOfWeek() already existed in lib/format.ts, just unused. */}
        <span class="text-[0.6rem] font-bold uppercase tracking-[0.16em] text-gold-300">
          {dayOfWeek(startDate)}
        </span>
        <span class="text-[0.6rem] font-bold uppercase tracking-[0.16em] text-gold-300">
          {monthShort(startDate)}
        </span>
        <span class="numeral text-3xl leading-none">{dayNum(startDate)}</span>
      </div>
    </div>

    {
      !upcoming && (resultSummary || finish) && (
        <div class="mt-4 border-l-2 border-gold/70 pl-3">
          {finish && (
            <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-gold-300">
              Best finish {finish}
            </p>
          )}
          {best && !placement && <p class="mt-1 text-sm text-bone-muted">{best.name}, {best.division}</p>}
          {resultSummary && <p class="mt-1 text-sm leading-relaxed text-bone-muted">{resultSummary}</p>}
        </div>
      )
    }

    {
      !upcoming && squads.length > 0 && (
        <details class="group/squads mt-3">
          <summary class="tap flex cursor-pointer list-none items-center gap-2 text-sm text-gold-300 underline underline-offset-4 [&::-webkit-details-marker]:hidden">
            All {squadCount}
            <Icon name="chevron" class="size-4 transition-transform group-open/squads:rotate-180" />
          </summary>
          <EventSquads squads={squads} class="mt-2" />
        </details>
      )
    }

    <div class="mt-auto flex flex-wrap items-center gap-3 pt-5">
      {takingRequests && <Button href="/join" size="sm">Request a spot</Button>}
      {
        upcoming && !takingRequests && (
          <p class="text-sm font-bold text-bone">Closed to new players for this event</p>
        )
      }
      {
        eventUrl && (
          <Button href={eventUrl} external variant="ghost" size="sm" aria-label={`${upcoming ? 'Details' : 'Results'} for ${name} on PBLeagues`}>
            {upcoming ? 'Event details' : 'Full results'}
          </Button>
        )
      }
    </div>
    <BrandRule spacing="none" class="mt-4 opacity-70" />
  </div>
</article>
