---
/**
 * CheckboxGroup — custom-styled checkbox set (Sept 2026 design-handoff
 * audit, §04.6): checked state fills the box solid gold with an embedded
 * check glyph. Same real-`<input>` + `peer-checked:` sibling technique as
 * `RadioGroup.astro` — see that file's comment for why.
 */
import Icon from '@/components/brand/Icon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  legend: string;
  name: string;
  options: Option[];
  defaultValues?: string[];
  class?: string;
}

const { legend, name, options, defaultValues = [], class: className = '' } = Astro.props;
---

<fieldset class={className}>
  <legend class="field-label">{legend}</legend>
  <div class="flex flex-col gap-2.5">
    {
      options.map((option) => (
        <label class="flex items-center gap-2.5 text-sm text-bone-muted cursor-pointer [&:has(:checked)]:text-bone">
          <span class="relative flex size-[18px] shrink-0">
            <input
              type="checkbox"
              name={name}
              value={option.value}
              checked={defaultValues.includes(option.value)}
              class="peer sr-only"
            />
            <span
              aria-hidden="true"
              class="absolute inset-0 rounded-[2px] border-2 border-ink-700 bg-transparent peer-checked:border-gold peer-checked:bg-gold peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-gold peer-focus-visible:outline-offset-1"
            />
            <Icon
              name="check"
              class="pointer-events-none absolute inset-0 m-auto size-3 text-ink opacity-0 peer-checked:opacity-100"
              strokeWidth={3}
            />
          </span>
          {option.label}
        </label>
      ))
    }
  </div>
</fieldset>
