---
/**
 * PlayerCard — the jersey-style roster card (§7 custom components).
 *
 * Reworked per the Sept 2026 design-handoff audit
 * (`_reference/design_handoff_leftovers_audit`, §04 "PlayerCard decision").
 * PRD §7 asked for a ghost numeral BEHIND the photo (what was built); the
 * earlier UI sheet drew the numeral BESIDE the photo in a gold frame with a
 * crimson name-plate — flagged back then as "the more distinctive card" but
 * left unresolved. This pass makes that call explicitly: beside, framed,
 * name-plate. A low-opacity ruyi-cloud corner accent ships with it (closes
 * the "corner clouds are section-level only" delta at the same time).
 *
 * Two states, one component:
 *  - `active`     : photo (or numeral/mascot fallback) + a separate gold-
 *                   framed numeral panel beside it, crimson name-plate,
 *                   role badge below.
 *  - `open-slot`  : dashed-border "OPEN SLOT — JOIN THE ROSTER" card with the
 *                   mascot in place of a photo. Untouched by this pass — the
 *                   handoff's before/after only covers the active state.
 *
 * Heading level is a prop and defaults to h3 — a card must never introduce a
 * competing h1 (§10.3).
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import MascotMark from './brand/MascotMark.astro';
import RuyiCloud from './brand/RuyiCloud.astro';
import type { CloudVariant } from '@/lib/clouds';
import Icon from './brand/Icon.astro';
import { resolveImage } from '@/lib/images';

interface Props {
  player: CollectionEntry<'players'>;
  as?: 'h2' | 'h3' | 'h4';
  /** Link the card through to the player's roster anchor. */
  href?: string;
  class?: string;
}

const { player, as: Heading = 'h3', href, class: className = '' } = Astro.props;
const { name, number, role, photo, photoAlt, status } = player.data;
const photoAsset = await resolveImage(photo);
const isOpenSlot = status === 'open-slot';

// Deterministic corner-cloud variant/flip per player, derived from data the
// card already has — no extra prop needed at any call site, and no two
// adjacent cards land on the identical cloud by coincidence more than 1-in-6
// of the time (six licensed variants ship; see src/lib/clouds.ts).
const cloudSeed = number ?? name.length;
const cloudVariant = ((cloudSeed % 6) + 1) as CloudVariant;
const cloudFlip = cloudSeed % 2 === 0;
---

{
  isOpenSlot ? (
    <a
      href={href ?? '/contact'}
      class:list={[
        'group flex flex-col items-center justify-center gap-3 rounded-sm border-2 border-dashed border-gold/60 bg-ink-800/60 px-5 py-8 text-center transition-colors hover:border-gold hover:bg-ink-700',
        className,
      ]}
    >
      <MascotMark class="w-20 transition-transform duration-300 group-hover:-translate-y-1 sm:w-24" width={96} />
      <Heading class="text-xl text-bone sm:text-2xl">Open Slot</Heading>
      <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-gold-300">
        Join the roster
      </p>
      <span class="tap mt-1 inline-flex items-center justify-center rounded-full border border-gold text-gold transition-colors group-hover:bg-gold group-hover:text-ink">
        <Icon name="arrow-right" class="size-5" />
      </span>
    </a>
  ) : (
    <article
      class:list={[
        'group relative overflow-hidden rounded-sm border border-ink-600 bg-ink-800 p-3 transition-colors hover:border-gold/60',
        className,
      ]}
    >
      <RuyiCloud
        variant={cloudVariant}
        flip={cloudFlip}
        class="pointer-events-none absolute -left-3 -top-3 h-16 w-auto text-crimson/20"
      />

      <div class="relative z-[1] flex gap-2.5">
        {/* Photo (or fallback) — its own column now, not the whole card. */}
        <div class="relative aspect-[4/5] flex-1 overflow-hidden rounded-sm border border-ink-600 bg-ink-900">
          {photoAsset ? (
            <Image
              src={photoAsset}
              alt={photoAlt ?? `${name}, ${role} for The Leftovers`}
              widths={[240, 400, 640]}
              sizes="(min-width: 1024px) 260px, (min-width: 640px) 40vw, 78vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover object-top mix-blend-luminosity transition-all duration-500 group-hover:mix-blend-normal"
            />
          ) : (
            <div class="flex size-full items-center justify-center">
              <MascotMark class="w-2/5" width={128} dim />
            </div>
          )}
        </div>

        {/* Numeral panel — beside the photo, gold-framed, only when a
            number is assigned. */}
        {number !== undefined && (
          <div class="flex w-14 shrink-0 items-center justify-center rounded-sm border-2 border-gold bg-ink-900 sm:w-16">
            <span class="numeral text-3xl leading-none sm:text-4xl" aria-hidden="true">
              {number}
            </span>
            <span class="sr-only">Number {number}</span>
          </div>
        )}
      </div>

      <div class="relative z-[1] mt-2.5 bg-crimson px-3 py-2">
        <Heading class="truncate text-base text-bone sm:text-lg">
          {href ? <a href={href} class="hover:text-bone/80">{name}</a> : name}
        </Heading>
      </div>

      <span class="relative z-[1] mt-2 inline-flex rounded-full border border-gold px-3 py-1 text-[0.6rem] font-bold uppercase tracking-[0.2em] text-gold-300">
        {role}
      </span>
    </article>
  )
}
