---
/**
 * ImpactBand — a full-bleed action photo that fades into bold copy on one
 * side (Nov 2026 design pass, after the "Paintball builds better people"
 * band in `docs/design/homepage-mockup-b.webp`).
 *
 * FeatureRow boxes the photo next to the copy. This lets the photo own the
 * full width, the way sports-energy brands frame athletes: the image fades
 * into a solid colour under the copy, and also at its top and bottom edges
 * so it melts into the sections around it instead of sitting on a hard line.
 *
 * Mobile first:
 *  - phones/tablets: the photo stacks on top and fades down into the copy,
 *    which overlaps its bottom edge, so text never sits on a busy part of a
 *    photo at phone width;
 *  - lg+: the photo fills the band and the copy sits over the faded side
 *    (`align`), vertically centred.
 *
 * Colour (both props, any combination):
 *  - `tone` is the wash the photo fades into: `ink` (black, the default),
 *    `crimson` or `forest`. The wash is SOLID under the copy, not a gradient, so body
 *    text always sits on a flat brand colour and passes AA. On `crimson`
 *    and `forest` the body copy is full bone, not bone-muted.
 *  - `treatment="duotone"` also tints the whole photo in the tone (greyscale
 *    + a 'color' blend that swaps in the tone's hue but keeps the photo's
 *    brightness), for a poster look or when a photo's own colours
 *    fight the brand. With `ink` that's a black-and-white photo. The tint
 *    strength is set per tone (`tint` below): crimson is the most
 *    saturated colour, so it tints at half strength or it floods the photo.
 *
 * Desktop-only options for photos that won't sit nicely behind the copy:
 *  - `shift` moves the photo sideways, -30..30 (% of the band; negative =
 *    left). Most action shots centre the player, so with the copy on the
 *    right the player ends up half under it and its fade: `shift={-28}` slides
 *    them clear (the copy column plus fade covers ~80% of the band).
 *    Away from the copy on a washed band it simply slides (the gap lands
 *    under the solid wash). Otherwise (wash="none", or toward the copy) it
 *    also widens so no edge shows, which crops a little more top and
 *    bottom: keep those shifts small (about 10).
 *    `focus` (CSS object-position) still picks the crop.
 *  - `wash="none"` drops the side fade and edge melts so the photo shows
 *    edge to edge in full colour (or in the duotone tint). Phones keep the
 *    stacked layout and its fade, so they are always readable.
 *  - `backdrop` keeps text readable over a busy photo: `scrim` (soft
 *    shadow gradient behind the copy plus text shadow; the default with
 *    wash="none") or `panel` (a solid tinted, blurred box). Use `panel`
 *    whenever there's body text or stats: a scrim alone can't guarantee AA
 *    over a bright photo.
 *
 * Pick a photo whose subject is on the side AWAY from the copy, and nudge it
 * with `focus` or `shift`. `ghost` puts an outlined word huge
 * behind the copy; it is aria-hidden, so don't put meaning there.
 *
 * Headings render at the level the caller passes (default h2). The title
 * accepts "\n" for deliberate line breaks; keep titles to two short lines.
 */
import { Image } from 'astro:assets';

interface Stat {
  value: string | number;
  label: string;
}

export type ImpactTone = 'ink' | 'crimson' | 'forest';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  /** Which side the copy sits on; the photo fades toward it. */
  align?: 'left' | 'right';
  /** object-position for the photo, e.g. "70% 30%". */
  focus?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  stats?: Stat[];
  ghost?: string;
  tone?: ImpactTone;
  treatment?: 'fade' | 'duotone';
  /** Desktop: `none` shows the photo edge to edge, no side fade or edge melts. */
  wash?: 'fade' | 'none';
  /** Desktop: what sits behind the copy. Default: none with a wash, scrim without. */
  backdrop?: 'none' | 'scrim' | 'panel';
  /** Desktop: slide the photo sideways, -30..30 (% of the band, negative = left). */
  shift?: number;
  as?: 'h2' | 'h3';
  /** Set when the band is above the fold, so the photo isn't lazy-loaded. */
  priority?: boolean;
  id?: string;
  class?: string;
}

const {
  image,
  imageAlt,
  align = 'left',
  focus,
  eyebrow,
  title,
  body,
  stats = [],
  ghost,
  tone = 'ink',
  treatment = 'fade',
  wash = 'fade',
  backdrop: backdropProp,
  shift = 0,
  as: Heading = 'h2',
  priority = false,
  id,
  class: className = '',
} = Astro.props;

const right = align === 'right';
const lines = title.split('\n');
const position = focus ?? (right ? '30% 35%' : '70% 35%');

const tones = {
  ink: { wash: 'var(--color-ink)', bg: 'bg-ink', body: 'text-bone-muted', bar: 'bg-crimson', label: 'text-bone-muted', tint: 1 },
  crimson: { wash: 'var(--color-crimson)', bg: 'bg-crimson', body: 'text-bone', bar: 'bg-gold', label: 'text-bone', tint: 0.45 },
  forest: { wash: 'var(--color-forest)', bg: 'bg-forest', body: 'text-bone', bar: 'bg-gold', label: 'text-bone', tint: 0.75 },
} as const;
const t = tones[tone];
const mix = (pct: number) => `color-mix(in srgb, ${t.wash} ${pct}%, transparent)`;

// Solid under the copy column (0–44%), then a quick fall-off to the photo.
const sideFade = `linear-gradient(to ${right ? 'left' : 'right'}, ${t.wash} 0%, ${t.wash} 44%, ${mix(80)} 56%, ${mix(35)} 67%, transparent 80%)`;
const downFade = `linear-gradient(to top, ${t.wash} 0%, ${mix(70)} 22%, transparent 60%)`;
const edgeMelt = `linear-gradient(to bottom, ${t.wash}, transparent 14%, transparent 84%, ${t.wash})`;
const hasActions = Astro.slots.has('actions');

const washed = wash === 'fade';
const backdrop = backdropProp ?? (washed ? 'none' : 'scrim');
// Shift. Moving the photo AWAY from the copy on a washed band just slides it:
// the strip it uncovers is on the copy side, which the solid wash covers
// anyway, so there's no zoom and no extra crop. Any other case (wash="none",
// or moving toward the copy) would expose a bare edge, so the layer widens
// toward the far side by twice the offset instead: the centre still moves by
// `shift`, at the cost of cropping a little more top and bottom.
const s = Math.max(-30, Math.min(30, shift));
const away = right ? s < 0 : s > 0;
const shiftVars = !s
  ? undefined
  : washed && away
    ? `--impact-x:${s}%`
    : `--impact-l:${s < 0 ? 2 * s : 0}%;--impact-r:${s > 0 ? -2 * s : 0}%`;
const scrim = `linear-gradient(to ${right ? 'left' : 'right'}, ${mix(78)} 0%, ${mix(55)} 30%, ${mix(20)} 52%, transparent 66%)`;
// Over a full photo, body copy reads better in full bone than bone-muted.
const bodyColour = washed ? t.body : `${t.body} lg:text-bone`;
---

<section id={id} class:list={['relative isolate overflow-hidden', t.bg, className]}>
  <div class="impact-media relative lg:absolute lg:inset-0" style={shiftVars}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 960, 1440, 1920, 2400]}
      sizes="100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      class:list={[
        'impact-photo aspect-[4/3] w-full object-cover sm:aspect-[16/9] lg:aspect-auto lg:h-full',
        treatment === 'duotone' && 'grayscale contrast-125',
      ]}
      style={`object-position:${position}`}
    />
    {
      treatment === 'duotone' && (
        <div class="impact-photo absolute inset-0 mix-blend-color" style={`background:${t.wash};opacity:${t.tint}`} aria-hidden="true" />
      )
    }
    {/* Phones/tablets: fade down into the copy below. */}
    <div class="absolute inset-0 lg:hidden" style={`background:${downFade}`} aria-hidden="true" />
    {/* Desktop: fade sideways under the copy, plus top/bottom edge melts. */}
    {washed && <div class="absolute inset-0 hidden lg:block" style={`background:${sideFade}`} aria-hidden="true" />}
    {washed && <div class="absolute inset-0 hidden lg:block" style={`background:${edgeMelt}`} aria-hidden="true" />}
  </div>
  {/* Scrim sits over the band, not the (shifted) photo, so it stays put. */}
  {backdrop === 'scrim' && <div class="absolute inset-0 hidden lg:block" style={`background:${scrim}`} aria-hidden="true" />}

  <div class="relative mx-auto -mt-16 max-w-7xl px-4 pb-14 sm:-mt-24 sm:px-6 sm:pb-16 lg:mt-0 lg:flex lg:min-h-[36rem] lg:items-center lg:py-20 xl:min-h-[40rem]">
    <div
      class:list={[
        'relative max-w-2xl lg:max-w-[56%]',
        right && 'lg:ml-auto lg:text-right',
        backdrop === 'scrim' && 'impact-scrim',
        backdrop === 'panel' && 'impact-panel lg:max-w-[48%]',
      ]}
      style={backdrop === 'panel' ? `--impact-panel:${mix(84)}` : undefined}
    >
      {
        ghost && (
          <span
            class:list={[
              'pointer-events-none absolute -top-10 select-none font-display text-[5.5rem] uppercase leading-none text-transparent opacity-60 sm:-top-14 sm:text-[8rem] lg:-top-20 lg:text-[11rem]',
              right ? 'right-0' : 'left-0',
            ]}
            style="-webkit-text-stroke:1px color-mix(in srgb, var(--color-gold) 35%, transparent)"
            aria-hidden="true"
          >
            {ghost}
          </span>
        )
      }
      {
        eyebrow && (
          <p class:list={['eyebrow relative mb-3 flex items-center gap-3 sm:mb-4', right && 'lg:flex-row-reverse']}>
            <span class:list={['block h-[3px] w-8 sm:w-10', t.bar]} aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <Heading class="relative text-4xl leading-[0.92] text-bone sm:text-5xl xl:text-[4rem]">
        {lines.map((line) => <span class="block">{line}</span>)}
      </Heading>
      {
        body && (
          <p class:list={['relative mt-5 max-w-md text-base leading-relaxed sm:mt-6 sm:text-lg', bodyColour, right && 'lg:ml-auto']}>
            {body}
          </p>
        )
      }
      {
        stats.length > 0 && (
          <dl
            class:list={[
              'relative mt-7 grid grid-cols-3 items-end gap-4 sm:mt-8 sm:flex sm:flex-wrap sm:gap-x-3 sm:gap-y-4',
              right && 'lg:justify-end',
            ]}
          >
            {/* The gold slash between stats is a pseudo-element (a <dl> may
                only contain dt/dd groups), shown from sm up; phones get an
                even three-column grid instead so nothing wraps mid-row. */}
            {stats.map((stat, i) => (
              <div
                class:list={[
                  'relative flex flex-col-reverse',
                  i > 0 && "sm:pl-8 sm:before:absolute sm:before:bottom-6 sm:before:left-1 sm:before:text-xl sm:before:text-gold sm:before:content-['/']",
                ]}
              >
                <dt class:list={['mt-1 text-[0.6rem] font-bold uppercase tracking-[0.16em] sm:text-xs sm:tracking-[0.2em]', t.label]}>
                  {stat.label}
                </dt>
                <dd class="numeral text-3xl leading-[0.85] sm:text-5xl">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        hasActions && (
          <div class:list={['relative mt-8 flex flex-col gap-3 sm:flex-row', right && 'lg:justify-end']}>
            <slot name="actions" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    /* shift: the photo layer grows toward one side (see shiftVars). */
    .impact-media {
      left: var(--impact-l, 0);
      right: var(--impact-r, 0);
    }
    /* Only the photo (and its tint) slides; the fades stay put under the copy. */
    .impact-photo {
      transform: translateX(var(--impact-x, 0));
    }
    .impact-scrim {
      text-shadow: 0 2px 18px rgb(0 0 0 / 0.55);
    }
    .impact-panel {
      padding: 2.25rem 2.5rem;
      border: 1px solid color-mix(in srgb, var(--color-gold) 25%, transparent);
      border-radius: 2px;
      background: var(--impact-panel);
      backdrop-filter: blur(10px);
    }
  }
</style>
