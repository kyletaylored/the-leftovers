---
/**
 * ImpactBand — a full-bleed action photo that fades into bold copy on one
 * side (Nov 2026 design pass, after the "Paintball builds better people"
 * band in `docs/design/homepage-mockup-b.webp`).
 *
 * FeatureRow boxes the photo next to the copy. This lets the photo own the
 * full width, the way sports-energy brands frame athletes: the image fades
 * to ink under the copy, and also at its top and bottom edges so it melts
 * into the sections around it instead of sitting on a hard line.
 *
 * Layout:
 *  - lg+: the photo fills the band; the copy sits over the faded side
 *    (`align`), vertically centred.
 *  - below lg: the photo stacks on top and fades down into the copy, which
 *    overlaps its bottom edge, so text never sits on a busy part of a photo
 *    at phone width.
 *
 * Pick a photo whose subject is on the side AWAY from the copy, and nudge it
 * with `focus` (CSS object-position). `ghost` puts an outlined word huge
 * behind the copy; it is aria-hidden, so don't put meaning there.
 *
 * Headings render at the level the caller passes (default h2). The title
 * accepts "\n" for deliberate line breaks.
 */
import { Image } from 'astro:assets';

interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  /** Which side the copy sits on; the photo fades toward it. */
  align?: 'left' | 'right';
  /** object-position for the photo, e.g. "70% 30%". */
  focus?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  stats?: Stat[];
  ghost?: string;
  /** `crimson` washes the faded side in brand red instead of plain ink. */
  tone?: 'ink' | 'crimson';
  as?: 'h2' | 'h3';
  /** Set when the band is above the fold, so the photo isn't lazy-loaded. */
  priority?: boolean;
  id?: string;
  class?: string;
}

const {
  image,
  imageAlt,
  align = 'left',
  focus,
  eyebrow,
  title,
  body,
  stats = [],
  ghost,
  tone = 'ink',
  as: Heading = 'h2',
  priority = false,
  id,
  class: className = '',
} = Astro.props;

const right = align === 'right';
const lines = title.split('\n');
const position = focus ?? (right ? '30% 35%' : '70% 35%');
const wash = tone === 'crimson' ? 'var(--color-crimson)' : 'var(--color-ink)';
const sideFade = `linear-gradient(to ${right ? 'left' : 'right'}, ${wash} 0%, color-mix(in srgb, ${wash} 92%, transparent) 30%, color-mix(in srgb, ${wash} 62%, transparent) 48%, color-mix(in srgb, ${wash} 18%, transparent) 66%, transparent 82%)`;
const hasActions = Astro.slots.has('actions');
---

<section id={id} class:list={['relative isolate overflow-hidden bg-ink', className]}>
  <div class="relative lg:absolute lg:inset-0">
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 960, 1440, 1920, 2400]}
      sizes="100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      class="aspect-[4/3] w-full object-cover sm:aspect-[16/9] lg:aspect-auto lg:h-full"
      style={`object-position:${position}`}
    />
    {/* Phone/tablet: fade down into the copy below. */}
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent lg:hidden" aria-hidden="true" />
    {/* Desktop: fade sideways under the copy, plus top/bottom edge melts. */}
    <div class="absolute inset-0 hidden lg:block" style={`background:${sideFade}`} aria-hidden="true" />
    <div
      class="absolute inset-0 hidden lg:block"
      style="background:linear-gradient(to bottom, var(--color-ink), transparent 16%, transparent 80%, var(--color-ink))"
      aria-hidden="true"
    />
  </div>

  <div class="relative mx-auto -mt-20 max-w-7xl px-4 pb-16 sm:-mt-28 sm:px-6 lg:mt-0 lg:flex lg:min-h-[40rem] lg:items-center lg:py-24 xl:min-h-[46rem]">
    <div class:list={['relative max-w-xl xl:max-w-2xl', right && 'lg:ml-auto lg:text-right']}>
      {
        ghost && (
          <span
            class:list={[
              'pointer-events-none absolute -top-12 select-none font-display text-[7rem] uppercase leading-none text-transparent opacity-60 sm:-top-16 sm:text-[10rem] lg:-top-24 lg:text-[13rem]',
              right ? 'right-0' : 'left-0',
            ]}
            style="-webkit-text-stroke:1px color-mix(in srgb, var(--color-gold) 35%, transparent)"
            aria-hidden="true"
          >
            {ghost}
          </span>
        )
      }
      {
        eyebrow && (
          <p class:list={['eyebrow relative mb-4 flex items-center gap-3', right && 'lg:flex-row-reverse']}>
            <span class="block h-[3px] w-10 bg-crimson" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <Heading class="relative text-5xl leading-[0.9] text-bone sm:text-6xl lg:text-7xl xl:text-8xl">
        {lines.map((line) => <span class="block">{line}</span>)}
      </Heading>
      {
        body && (
          <p class:list={['relative mt-6 max-w-md text-base leading-relaxed text-bone-muted sm:text-lg', right && 'lg:ml-auto']}>
            {body}
          </p>
        )
      }
      {
        stats.length > 0 && (
          <dl
            class:list={[
              'relative mt-8 grid grid-cols-3 items-end gap-4 sm:flex sm:flex-wrap sm:gap-x-3 sm:gap-y-4',
              right && 'lg:justify-end',
            ]}
          >
            {/* The gold slash between stats is a pseudo-element (a <dl> may
                only contain dt/dd groups), shown from sm up; phones get an
                even three-column grid instead so nothing wraps mid-row. */}
            {stats.map((stat, i) => (
              <div
                class:list={[
                  'relative flex flex-col-reverse',
                  i > 0 && "sm:pl-8 sm:before:absolute sm:before:bottom-6 sm:before:left-1 sm:before:text-xl sm:before:text-gold sm:before:content-['/']",
                ]}
              >
                <dt class="mt-1 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-bone-muted sm:text-xs sm:tracking-[0.2em]">
                  {stat.label}
                </dt>
                <dd class="numeral text-3xl leading-[0.85] sm:text-5xl">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        hasActions && (
          <div class:list={['relative mt-9 flex flex-col gap-3 sm:flex-row', right && 'lg:justify-end']}>
            <slot name="actions" />
          </div>
        )
      }
    </div>
  </div>
</section>
