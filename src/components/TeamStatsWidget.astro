---
/**
 * TeamStatsWidget — one squad's record from pblidb.org, fetched at build time
 * by getTeamWidgets() in src/lib/pblidb.ts, which also decides which squads
 * qualify.
 *
 * "Results" counts only matches with a known result, so it always agrees with
 * the record beside it. pblidb's own match count can be higher while its data
 * is still being backfilled. Show ATTRIBUTION from the same file near any use.
 */
import { decidedMatches, type PblidbTeamSummary } from '@/lib/pblidb';

interface Props {
  widget: PblidbTeamSummary;
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const { widget, as: Heading = 'h3', class: className = '' } = Astro.props;
const record = `${widget.wins}-${widget.losses}${widget.ties ? `-${widget.ties}` : ''}`;
---

<div class:list={['rounded-sm border border-ink-600 bg-ink-800 p-5', className]}>
  <p class="eyebrow mb-1">pblidb.org</p>
  <Heading class="title-sm text-bone">{widget.canonicalName}</Heading>
  <dl class="mt-4 grid grid-cols-3 gap-3 text-center">
    <div>
      <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-bone-muted">Record</dt>
      <dd class="numeral mt-1 text-2xl leading-none">{record}</dd>
    </div>
    <div>
      <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-bone-muted">Results</dt>
      <dd class="numeral mt-1 text-2xl leading-none">{decidedMatches(widget)}</dd>
    </div>
    <div>
      <dt class="text-[0.65rem] uppercase tracking-[0.14em] text-bone-muted">Events</dt>
      <dd class="numeral mt-1 text-2xl leading-none">{widget.events}</dd>
    </div>
  </dl>
  {widget.lastEventName && <p class="mt-4 text-xs text-bone-muted">Last played: {widget.lastEventName}</p>}
</div>
