---
/**
 * NewsletterBlock — a native <form> posting DIRECTLY to the email provider
 * (§4, §8.3).
 *
 * The action URL comes from site settings, so switching Buttondown →
 * Mailchimp is a CMS edit, not a code change. No PII ever touches our
 * infrastructure and there is no backend to run: the provider owns the
 * double-opt-in, the list and the unsubscribe link.
 */
import { site } from '@/lib/settings';
import Lantern from './brand/Lantern.astro';
import MascotMark from './brand/MascotMark.astro';
import Icon from './brand/Icon.astro';

interface Props {
  title?: string;
  eyebrow?: string;
  body?: string;
  as?: 'h2' | 'h3';
  class?: string;
}
const {
  title = 'Community & Newsletter',
  eyebrow = 'Stay in the loop',
  body = 'Event dates, roster openings, and jersey drops — a few emails a season, never more.',
  as: Heading = 'h2',
  class: className = '',
} = Astro.props;

const { formAction, emailFieldName, hiddenFields } = site.mailingList;
---

<div
  class:list={[
    'relative overflow-hidden rounded-sm border border-ink-600 bg-ink-800 p-6 sm:p-8',
    className,
  ]}
>
  <Lantern class="pointer-events-none absolute -top-4 left-4 hidden h-28 w-auto opacity-50 lg:block" cord={30} />
  <MascotMark
    class="pointer-events-none absolute -bottom-3 right-4 hidden w-24 lg:block"
    width={96}
    dim
  />

  <div class="relative lg:pl-24">
    <p class="eyebrow mb-2">{eyebrow}</p>
    <Heading class="text-3xl text-bone sm:text-4xl">{title}</Heading>
    <p class="mt-2 max-w-md text-sm leading-relaxed text-bone-muted">{body}</p>

    <form
      action={formAction}
      method="post"
      target="_blank"
      class="mt-5 flex flex-col gap-3 sm:max-w-lg sm:flex-row"
    >
      {Object.entries(hiddenFields).map(([name, value]) => <input type="hidden" name={name} value={value} />)}

      <div class="flex-1">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name={emailFieldName}
          required
          autocomplete="email"
          placeholder="Enter your email address…"
          class="tap w-full rounded-sm border border-ink-600 bg-ink-900 px-4 py-3 text-sm text-bone placeholder:text-bone-muted/70 focus:border-gold focus:outline-none"
        />
      </div>

      <button
        type="submit"
        class="tap inline-flex shrink-0 items-center justify-center gap-2 rounded-sm bg-crimson px-6 py-3 text-xs font-bold uppercase tracking-[0.14em] text-bone transition-colors hover:bg-crimson-600"
      >
        Subscribe
        <Icon name="arrow-right" class="size-4" />
      </button>
    </form>

    <p class="mt-3 text-xs text-bone-muted">
      Handled by {site.mailingList.provider}. Unsubscribe any time — we never sell or share your
      address.
    </p>
  </div>
</div>
