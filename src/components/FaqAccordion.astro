---
/**
 * FaqAccordion — native <details>/<summary> (§7).
 *
 * Deliberately zero JavaScript: the browser already gives us keyboard
 * operation, screen-reader semantics and open/close state for free, which is
 * more than a hand-rolled accordion island would, for 0 KB.
 */
interface Props {
  items: Array<{ question: string; answer: string }>;
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class:list={['divide-y divide-ink-600/70 overflow-hidden rounded-sm border border-ink-600', className]}>
  {
    items.map((item) => (
      <details class="group bg-ink-800">
        <summary
          class="tap flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-base font-semibold text-bone hover:bg-ink-700"
        >
          <span>{item.question}</span>
          <span
            class="shrink-0 text-2xl leading-none text-gold transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true">+</span
          >
        </summary>
        <div class="px-5 pb-5 text-sm leading-relaxed text-bone-muted">{item.answer}</div>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
