---
/**
 * Hero — the page-opening block (§7).
 *
 * `brand` renders the official logo lockup. The logo art already contains the
 * wordmark, so nothing else competes with it here: one image, a tagline, two
 * actions, and room to breathe. Earlier versions stacked a separate mascot and
 * wordmark side by side at 64/52 units tall, which is what made the homepage
 * feel magnified.
 *
 * `image` and `video` put photography behind the copy; `text` is copy only.
 *
 * The logo is the LCP element on the homepage, so it is eager, high-priority,
 * and width/height-locked. Everything decorative around it is SVG.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/img/brand/logo.png';
import RuyiCloud from './brand/RuyiCloud.astro';
import TerracedDivider from './brand/TerracedDivider.astro';
import { site } from '@/lib/settings';

interface Props {
  variant?: 'brand' | 'image' | 'video' | 'text';
  title?: string;
  tagline?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** `video` variant: path to the looping clip, e.g. "/video/break.mp4". */
  video?: string;
  /** Required for `video` — it's the poster AND the reduced-motion fallback. */
  poster?: ImageMetadata;
  class?: string;
}

const {
  variant = 'brand',
  title,
  tagline,
  image,
  imageAlt = '',
  video,
  poster,
  class: className = '',
} = Astro.props;

if (variant === 'video' && (!video || !poster)) {
  throw new Error('Hero variant="video" requires both `video` and `poster`.');
}

const backdrop = variant === 'video' ? poster : image;
---

<section class:list={['bg-topo relative overflow-hidden', className]}>
  {
    (variant === 'image' || variant === 'video') && backdrop && (
      <>
        <Image
          src={backdrop}
          alt={imageAlt}
          widths={[640, 960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover opacity-40"
        />
        {variant === 'video' && (
          <video
            class="hero-video absolute inset-0 size-full object-cover opacity-40"
            src={video}
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30" />
      </>
    )
  }

  <!-- Ruyi-cloud banks rolling in from the top corners (§9 motif). -->
  <RuyiCloud
    variant={1}
    class="pointer-events-none absolute -left-10 -top-5 h-14 w-auto text-crimson sm:h-24 lg:h-36"
  />
  <RuyiCloud
    variant={2}
    flip
    class="pointer-events-none absolute -right-10 -top-5 h-14 w-auto text-crimson sm:h-24 lg:h-36"
  />

  <div class="relative mx-auto max-w-5xl px-4 pb-24 pt-12 text-center sm:px-6 sm:pb-28 lg:pb-32 lg:pt-16">
    {
      variant === 'brand' ? (
        <>
          {/* The logo carries the accessible name, so the h1 is visually
              hidden rather than duplicated on screen. */}
          <h1 class="sr-only">{title ?? `${site.title} — ${site.tagline}`}</h1>
          <Image
            src={logo}
            alt={`${site.title} logo`}
            widths={[224, 288, 320, 448, 640]}
            sizes="(min-width: 1024px) 320px, (min-width: 640px) 288px, 224px"
            quality={68}
            loading="eager"
            fetchpriority="high"
            class="mx-auto h-auto w-56 sm:w-72 lg:w-80"
          />
          {tagline && (
            <p class="mx-auto mt-6 max-w-xl text-[0.62rem] font-bold uppercase tracking-[0.28em] text-bone-muted sm:text-xs sm:tracking-[0.32em]">
              {tagline}
            </p>
          )}
        </>
      ) : (
        <div class="mx-auto max-w-3xl">
          <h1 class="text-4xl text-bone sm:text-5xl lg:text-6xl">{title}</h1>
          {tagline && (
            <p class="mt-4 text-base leading-relaxed text-bone-muted sm:text-lg">{tagline}</p>
          )}
        </div>
      )
    }

    <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center sm:gap-4">
      <slot name="actions" />
    </div>
  </div>

  <TerracedDivider seed={3} class="absolute bottom-0 left-0 h-14 sm:h-20 lg:h-24" />
</section>

<style>
  /* A background clip is decoration; under reduced-motion the poster is the
     whole hero. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>
