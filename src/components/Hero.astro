---
/**
 * Hero — the page-opening block (§7).
 *
 * `brand` renders the official logo lockup. The logo art already contains the
 * wordmark, so nothing else competes with it here: one image, a tagline, two
 * actions, and room to breathe. Earlier versions stacked a separate mascot and
 * wordmark side by side at 64/52 units tall, which is what made the homepage
 * feel magnified.
 *
 * `ornate` (Nov 2026 design pass, after `docs/design/homepage-mockup-b.webp`)
 * is the same logo lockup dressed for a showpiece: gilded ruyi-cloud banks
 * with swaying paper lanterns in both top corners (CloudCorner), a warm gold
 * glow behind the logo, and the layered RiceTerraces landscape along the
 * bottom in place of the single-line TerracedDivider.
 *
 * `image` and `video` put photography behind the copy; `text` is copy only.
 *
 * The logo is the LCP element on the homepage, so it is eager, high-priority,
 * and width/height-locked. Everything decorative around it is SVG/CSS.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/img/brand/logo.png';
import RuyiCloud from './brand/RuyiCloud.astro';
import TerracedDivider from './brand/TerracedDivider.astro';
import CloudCorner from './brand/CloudCorner.astro';
import RiceTerraces from './brand/RiceTerraces.astro';
import { site } from '@/lib/settings';

interface Props {
  variant?: 'brand' | 'ornate' | 'image' | 'video' | 'text';
  title?: string;
  tagline?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** `video` variant: path to the looping clip, e.g. "/video/break.mp4". */
  video?: string;
  /** Required for `video` — it's the poster AND the reduced-motion fallback. */
  poster?: ImageMetadata;
  class?: string;
}

const {
  variant = 'brand',
  title,
  tagline,
  image,
  imageAlt = '',
  video,
  poster,
  class: className = '',
} = Astro.props;

if (variant === 'video' && (!video || !poster)) {
  throw new Error('Hero variant="video" requires both `video` and `poster`.');
}

const backdrop = variant === 'video' ? poster : image;
const isLogo = variant === 'brand' || variant === 'ornate';
const ornate = variant === 'ornate';
// "Play / Compete / Leftovers" → spaced segments with gold slashes.
const taglineParts = tagline?.split('/').map((part) => part.trim()).filter(Boolean) ?? [];
---

<section class:list={[ornate ? 'bg-topo' : 'bg-sand', 'relative overflow-hidden', className]}>
  {
    (variant === 'image' || variant === 'video') && backdrop && (
      <>
        <Image
          src={backdrop}
          alt={imageAlt}
          widths={[640, 960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover opacity-40"
        />
        {variant === 'video' && (
          <video
            class="hero-video absolute inset-0 size-full object-cover opacity-40"
            src={video}
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30" />
      </>
    )
  }

  {
    ornate ? (
      <>
        {/* Warm lantern-light glow behind the logo. */}
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_55%_60%_at_50%_45%,color-mix(in_srgb,var(--color-gold)_16%,transparent),transparent_70%)]"
          aria-hidden="true"
        />
        <CloudCorner side="left" class="absolute -left-12 top-0 w-52 sm:-left-12 sm:-top-6 sm:w-72 lg:w-[26rem] xl:w-[30rem]" />
        <CloudCorner side="right" class="absolute -right-12 top-0 w-52 sm:-right-12 sm:-top-6 sm:w-72 lg:w-[26rem] xl:w-[30rem]" />
      </>
    ) : (
      <>
        {/* Ruyi-cloud banks rolling in from the top corners (§9 motif). */}
        <RuyiCloud
          variant={1}
          class="pointer-events-none absolute -left-10 -top-5 h-14 w-auto text-crimson sm:h-24 lg:h-36"
        />
        <RuyiCloud
          variant={2}
          flip
          class="pointer-events-none absolute -right-10 -top-5 h-14 w-auto text-crimson sm:h-24 lg:h-36"
        />
      </>
    )
  }

  <div
    class:list={[
      'relative mx-auto max-w-5xl px-4 text-center sm:px-6',
      ornate ? 'pb-24 pt-20 sm:pb-36 sm:pt-20 lg:pb-44 lg:pt-20' : 'pb-24 pt-12 sm:pb-28 lg:pb-32 lg:pt-16',
    ]}
  >
    {
      isLogo ? (
        <>
          {/* The logo carries the accessible name, so the h1 is visually
              hidden rather than duplicated on screen. */}
          <h1 class="sr-only">{title ?? `${site.title} — ${site.tagline}`}</h1>
          <Image
            src={logo}
            alt={`${site.title} logo`}
            widths={[224, 288, 320, 448, 640]}
            sizes="(min-width: 1024px) 320px, (min-width: 640px) 288px, 224px"
            quality={68}
            loading="eager"
            fetchpriority="high"
            class:list={[
              'mx-auto h-auto w-56 sm:w-72 lg:w-80',
              ornate && 'drop-shadow-[0_10px_30px_rgba(0,0,0,0.6)]',
            ]}
          />
          {tagline &&
            (ornate ? (
              <p class="mx-auto mt-7 flex max-w-xl flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[0.65rem] font-bold uppercase tracking-[0.3em] text-bone sm:text-xs sm:tracking-[0.36em]">
                {taglineParts.map((part, i) => (
                  <>
                    {i > 0 && <span class="text-gold" aria-hidden="true">/</span>}
                    <span>{part}</span>
                  </>
                ))}
              </p>
            ) : (
              <p class="mx-auto mt-6 max-w-xl text-[0.62rem] font-bold uppercase tracking-[0.28em] text-bone-muted sm:text-xs sm:tracking-[0.32em]">
                {tagline}
              </p>
            ))}
        </>
      ) : (
        <div class="mx-auto max-w-3xl">
          <h1 class="text-4xl text-bone sm:text-5xl lg:text-6xl">{title}</h1>
          {tagline && (
            <p class="mt-4 text-base leading-relaxed text-bone-muted sm:text-lg">{tagline}</p>
          )}
        </div>
      )
    }

    <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center sm:gap-4">
      <slot name="actions" />
    </div>
  </div>

  {
    ornate ? (
      <RiceTerraces seed={7} class="absolute bottom-0 left-0 h-28 sm:h-36 lg:h-48" />
    ) : (
      <TerracedDivider seed={3} style="pagoda" class="absolute bottom-0 left-0 h-14 sm:h-20 lg:h-24" />
    )
  }
</section>

<style>
  /* A background clip is decoration; under reduced-motion the poster is the
     whole hero. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>
