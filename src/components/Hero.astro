---
/**
 * Hero — the homepage brand lockup (§7 traditional components).
 *
 * Four variants per §7: `brand` (mascot + wordmark, the mockup's hero),
 * `image` (photography with an overlay), `video` (looping background) and
 * `text` (copy only).
 *
 * The `video` variant is the one that can wreck a mobile visit, so it is
 * deliberately conservative and ships ZERO JavaScript:
 *
 *  - A `poster` image is REQUIRED and is rendered through <Image> as the
 *    eager, high-priority backdrop. That image — not the video — is the LCP
 *    element, so the hero paints at the same speed as every other variant
 *    and can't shift when the clip arrives.
 *  - `muted` + `playsinline` + `preload="metadata"`: autoplay works without
 *    a script, and only metadata is fetched up front.
 *  - Under prefers-reduced-motion the <video> is hidden and paused in CSS and
 *    the poster stands in permanently.
 *
 * No loader script, deliberately: an inline one would be blocked by the
 * site's own CSP (`script-src 'self'`, see public/_headers), and a hoisted
 * one would ship a JS request to every page using ANY Hero variant, video or
 * not. The honest limitation of doing it declaratively is that a
 * reduced-motion visitor may still fetch the video's metadata before CSS
 * hides it — bounded by `preload="metadata"`, but not zero.
 *
 * Everything decorative here is SVG — clouds, lanterns, terraced ridge, the
 * topo texture — so the largest hero element by bytes is the wordmark, not a
 * 1.5MB background plate. That is the §10.1 media-weight rule applied at the
 * one place on the site most likely to break it, and it keeps the LCP
 * element text rather than an image.
 */
import { Image } from 'astro:assets';
import Mascot from './brand/Mascot.astro';
import Wordmark from './brand/Wordmark.astro';
import RuyiCloud from './brand/RuyiCloud.astro';
import Lantern from './brand/Lantern.astro';
import TerracedDivider from './brand/TerracedDivider.astro';

interface Props {
  variant?: 'brand' | 'image' | 'video' | 'text';
  title?: string;
  tagline?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** `video` variant: path to the looping clip, e.g. "/video/break.mp4". */
  video?: string;
  /** Required for `video` — it's the poster AND the reduced-motion fallback. */
  poster?: ImageMetadata;
  class?: string;
}

const {
  variant = 'brand',
  title,
  tagline,
  image,
  imageAlt = '',
  video,
  poster,
  class: className = '',
} = Astro.props;

// A video hero with no poster would flash empty and take the LCP hit with it.
if (variant === 'video' && (!video || !poster)) {
  throw new Error('Hero variant="video" requires both `video` and `poster`.');
}

const backdrop = variant === 'video' ? poster : image;
---

<section class:list={['bg-topo relative overflow-hidden', className]}>
  {
    (variant === 'image' || variant === 'video') && backdrop && (
      <>
        <Image
          src={backdrop}
          alt={imageAlt}
          widths={[640, 960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover opacity-45"
        />
        {variant === 'video' && (
          <video
            class="hero-video absolute inset-0 size-full object-cover opacity-45"
            src={video}
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30" />
      </>
    )
  }

  <!-- Ruyi-cloud corners + hanging lanterns (brand motifs, §9) -->
  <RuyiCloud side="left" class="pointer-events-none absolute -left-8 -top-6 h-32 w-auto sm:h-44 lg:h-56" />
  <RuyiCloud side="right" class="pointer-events-none absolute -right-8 -top-6 h-32 w-auto sm:h-44 lg:h-56" />
  <Lantern class="pointer-events-none absolute left-[12%] -top-2 hidden h-32 w-auto opacity-80 sm:block lg:h-44" cord={70} />
  <Lantern class="pointer-events-none absolute right-[12%] -top-4 hidden h-28 w-auto opacity-80 sm:block lg:h-40" cord={50} />

  <div class="relative mx-auto max-w-7xl px-4 pb-24 pt-14 sm:px-6 sm:pb-28 lg:pb-32 lg:pt-20">
    {
      variant === 'brand' ? (
        <div class="flex flex-col items-center gap-4 text-center lg:flex-row lg:justify-center lg:gap-10 lg:text-left">
          <Mascot class="h-36 w-auto shrink-0 sm:h-48 lg:h-64" />
          <div class="min-w-0">
            <h1 class="sr-only">{title ?? 'The Leftovers — semi-pro community paintball team'}</h1>
            <Wordmark class="mx-auto h-28 w-auto sm:h-40 lg:mx-0 lg:h-52" size="hero" label={false} />
            {tagline && (
              <p class="mt-3 text-[0.62rem] font-bold uppercase tracking-[0.3em] text-bone sm:text-sm sm:tracking-[0.34em]">
                {tagline}
              </p>
            )}
          </div>
        </div>
      ) : (
        <div class="max-w-3xl">
          <h1 class="text-5xl text-bone sm:text-6xl lg:text-7xl">{title}</h1>
          {tagline && (
            <p class="mt-4 text-base leading-relaxed text-bone-muted sm:text-lg">{tagline}</p>
          )}
        </div>
      )
    }

    <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center sm:gap-4">
      <slot name="actions" />
    </div>
  </div>

  <TerracedDivider seed={3} class="absolute bottom-0 left-0 h-16 sm:h-24 lg:h-28" />
</section>

<style>
  /* A background clip is decoration. Under reduced-motion the poster image
     underneath it is the whole hero. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>
