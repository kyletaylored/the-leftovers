---
/**
 * ImpactPlayground — the /design "build your own ImpactBand" tool. Doc chrome
 * only; never use on a public page.
 *
 * Renders ONE real ImpactBand, then a small script flips its data-* attributes
 * and CSS variables from the controls. That works because ImpactBand keeps a
 * fixed DOM and puts every option in CSS (see its doc comment), and the shift
 * maths is the same function the component uses (src/lib/impact.ts), so what
 * you see here is exactly what the component renders. It also prints the
 * matching <ImpactBand …> markup to copy.
 *
 * From lg up the controls are a vertical toolbar on the left, short enough to
 * see beside the band on a standard monitor, and every option is a dropdown to
 * keep it that way. The toolbar collapses to a narrow rail for more room (the
 * choice is remembered per browser); below lg it stacks above the band.
 *
 * Sample photos are real team shots chosen for where the subject sits
 * (centre, left, right, a wide group), which is what decides whether you need
 * `shift`/`focus`. Without JS the band shows the default options and the
 * controls are hidden.
 */
import { getImage } from 'astro:assets';
import ImpactBand from '@/components/marketing/ImpactBand.astro';
import Button from '@/components/Button.astro';
import centred from '@/assets/img/events/nxl-wc25/lo2nxlwc25-94-x5.webp';
import left from '@/assets/img/events/nxl-lso26/lo2nxllso26-219-x5.webp';
import right from '@/assets/img/events/social/fb-825327377-12228758.webp';
import wide from '@/assets/img/events/nxl-lso26/lo3nxllso26-51-x5.webp';

const samples = [
  { key: 'centred', label: 'Subject centred', src: centred, alt: 'A Leftovers player aims a paintball marker across a field.' },
  { key: 'left', label: 'Subject left', src: left, alt: 'A Leftovers player behind an inflatable bunker sights down a marker.' },
  { key: 'right', label: 'Subject right', src: right, alt: 'A Leftovers player dives in behind an orange inflatable bunker, marker low.' },
  { key: 'wide', label: 'Wide group', src: wide, alt: 'Three Leftovers players sprint out from behind a red inflatable bunker.' },
];
const photos = await Promise.all(
  samples.map(async (s) => {
    const img = await getImage({ src: s.src, widths: [640, 960, 1440, 1920, 2400], format: 'webp' });
    return { key: s.key, label: s.label, alt: s.alt, src: img.src, srcset: img.srcSet.attribute };
  })
);

type Choice = { name: string; label: string; options: string[] };
const choices: Choice[] = [
  { name: 'align', label: 'align', options: ['left', 'right'] },
  { name: 'tone', label: 'tone', options: ['ink', 'crimson', 'forest'] },
  { name: 'treatment', label: 'treatment', options: ['fade', 'duotone'] },
  { name: 'wash', label: 'wash (desktop)', options: ['fade', 'none'] },
  { name: 'backdrop', label: 'backdrop (desktop)', options: ['auto', 'none', 'scrim', 'panel'] },
];
const toggles = [
  { name: 'eyebrow', label: 'eyebrow', on: true },
  { name: 'body', label: 'body', on: true },
  { name: 'actions', label: 'actions', on: true },
  { name: 'ghost', label: 'ghost word', on: false },
];
/** Presets: option sets worth starting from. `photo` switches the sample too. */
const presets = [
  { label: 'Default', set: { align: 'left', tone: 'ink', treatment: 'fade', wash: 'fade', backdrop: 'auto', shift: 0 } },
  { label: 'Crimson duotone', set: { align: 'right', tone: 'crimson', treatment: 'duotone', wash: 'fade', backdrop: 'auto', shift: 0 } },
  { label: 'Forest poster', set: { align: 'left', tone: 'forest', treatment: 'duotone', wash: 'fade', backdrop: 'auto', shift: 0 } },
  { label: 'Centred subject fix', set: { photo: 'centred', align: 'right', tone: 'crimson', treatment: 'duotone', wash: 'fade', backdrop: 'auto', shift: -28 } },
  { label: 'Full colour + scrim', set: { photo: 'centred', align: 'right', tone: 'ink', treatment: 'fade', wash: 'none', backdrop: 'auto', shift: -8 } },
  { label: 'Full colour + panel', set: { photo: 'wide', align: 'left', tone: 'ink', treatment: 'fade', wash: 'none', backdrop: 'panel', shift: 0 } },
  { label: 'Tinted edge to edge', set: { photo: 'centred', align: 'right', tone: 'crimson', treatment: 'duotone', wash: 'none', backdrop: 'panel', shift: -8 } },
];
const labelText = 'mb-1 block font-mono text-[0.625rem] text-gold-300';
const pick = 'field-input !min-h-9 cursor-pointer !px-2 !py-1.5 text-xs';
---

<div
  class="impact-playground"
  data-playground
  data-photos={JSON.stringify(photos)}
  data-presets={JSON.stringify(presets)}
>
  <form class="pg-controls hidden border-b border-ink-600 bg-ink-900 lg:border-b-0 lg:border-r" aria-label="ImpactBand options" onsubmit="return false">
    <div class="pg-head flex items-center justify-between gap-2 border-b border-ink-600 p-1.5 pl-4">
      <p class="pg-heading text-[0.625rem] font-bold uppercase tracking-[0.16em] text-gold-300">Controls</p>
      <button type="button" class="pg-toggle tap grid size-11 shrink-0 cursor-pointer place-items-center text-gold-300 hover:text-bone" aria-expanded="true" aria-controls="pg-fields" aria-label="Hide controls">
        <svg viewBox="0 0 24 24" class="pg-toggle-icon size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>
    </div>

    <div id="pg-fields" class="space-y-4 p-4">
      <label class="block">
        <span class={labelText}>preset</span>
        <select name="preset" class={pick}>
          <option value="" disabled>Custom</option>
          {presets.map((p, i) => <option value={i}>{p.label}</option>)}
        </select>
      </label>

      <label class="block">
        <span class={labelText}>sample photo</span>
        <select name="photo" class={pick}>
          {photos.map((p) => <option value={p.key}>{p.label}</option>)}
        </select>
      </label>

      <div class="grid grid-cols-2 gap-3">
        {choices.map((c) => (
          <label class="block">
            <span class={labelText}>{c.label}</span>
            <select name={c.name} class={pick}>
              {c.options.map((o) => <option value={o}>{o}</option>)}
            </select>
          </label>
        ))}
      </div>

      <label class="block">
        <span class:list={[labelText, 'flex justify-between']}>shift (desktop) <output name="shiftOut">0</output></span>
        <input type="range" name="shift" min="-30" max="30" step="1" value="0" class="w-full accent-gold" />
      </label>
      <label class="block">
        <span class:list={[labelText, 'flex justify-between']}>focus x · y <output name="focusOut">auto</output></span>
        <span class="flex gap-2">
          <input type="range" name="focusX" min="0" max="100" step="1" value="70" class="w-full accent-gold" aria-label="Focus x (%)" />
          <input type="range" name="focusY" min="0" max="100" step="1" value="35" class="w-full accent-gold" aria-label="Focus y (%)" />
        </span>
      </label>
      <fieldset>
        <legend class={labelText}>content</legend>
        <div class="grid grid-cols-2 gap-x-3">
          {toggles.map((t) => (
            <label class="inline-flex min-h-8 cursor-pointer items-center gap-1.5 text-xs text-bone">
              <input type="checkbox" name={t.name} checked={t.on} class="size-4 accent-gold" />
              {t.label}
            </label>
          ))}
        </div>
      </fieldset>
    </div>
  </form>

  <div class="min-w-0">
    <ImpactBand
      as="h3"
      image={centred}
      imageAlt={samples[0].alt}
      eyebrow="Playground"
      title={'Build your\nown band.'}
      body="Change the options in the toolbar. Wash, backdrop and shift only change the desktop layout."
      ghost="Leftovers"
    >
      <Button slot="actions" href="/join" variant="gold">Join a squad</Button>
    </ImpactBand>

    <div class="pg-output hidden border-t border-ink-600 p-4 sm:p-[22px]">
      <div class="mb-1.5 flex items-center justify-between">
        <span class="font-mono text-[0.625rem] text-gold-300">markup</span>
        <button type="button" class="pg-copy min-h-9 cursor-pointer rounded-sm border border-ink-600 px-3 text-xs font-semibold text-bone hover:border-gold">Copy</button>
      </div>
      <pre class="overflow-x-auto rounded-sm bg-ink-900 p-3 text-[0.6875rem] leading-relaxed text-bone"><code class="pg-code"></code></pre>
      <p class="pg-hint mt-2 text-[0.6875rem] text-bone-muted" aria-live="polite"></p>
    </div>
  </div>
</div>

<style>
  /* Plain CSS, not Tailwind data-* variants: two of those on one property have
     equal specificity, so the collapsed width could lose to the open one. */
  @media (min-width: 1024px) {
    .impact-playground[data-ready='true'] {
      display: grid;
      grid-template-columns: 19rem minmax(0, 1fr);
    }
    .impact-playground[data-collapsed='true'] {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
    [data-collapsed='true'] .pg-head {
      justify-content: center;
      padding-left: 0.375rem;
    }
  }
  [data-collapsed='true'] .pg-toggle-icon {
    transform: rotate(180deg);
  }
  @media (max-width: 1023.98px) {
    .pg-toggle-icon {
      transform: rotate(90deg);
    }
    [data-collapsed='true'] .pg-toggle-icon {
      transform: rotate(-90deg);
    }
  }
</style>

<script>
  import { impactShiftVars } from '@/lib/impact';

  type Photo = { key: string; label: string; alt: string; src: string; srcset: string };
  type Preset = { label: string; set: Record<string, string | number> };

  for (const root of document.querySelectorAll<HTMLElement>('[data-playground]')) {
    const form = root.querySelector<HTMLFormElement>('.pg-controls')!;
    const output = root.querySelector<HTMLElement>('.pg-output')!;
    const fields = root.querySelector<HTMLElement>('#pg-fields')!;
    const heading = root.querySelector<HTMLElement>('.pg-heading')!;
    const toggle = root.querySelector<HTMLButtonElement>('.pg-toggle')!;
    const band = root.querySelector<HTMLElement>('section.impact')!;
    const img = band.querySelector<HTMLImageElement>('img.impact-photo')!;
    const code = root.querySelector<HTMLElement>('.pg-code')!;
    const hint = root.querySelector<HTMLElement>('.pg-hint')!;
    const photos: Photo[] = JSON.parse(root.dataset.photos!);
    const presets: Preset[] = JSON.parse(root.dataset.presets!);
    const parts = {
      eyebrow: band.querySelector<HTMLElement>('.impact-eyebrow'),
      body: band.querySelector<HTMLElement>('.impact-body'),
      actions: band.querySelector<HTMLElement>('.impact-actions'),
      ghost: band.querySelector<HTMLElement>('.impact-ghost'),
    };
    form.classList.remove('hidden');
    output.classList.remove('hidden');
    root.dataset.ready = 'true';

    const COLLAPSED_KEY = 'impact-playground-collapsed';
    const setCollapsed = (collapsed: boolean) => {
      root.dataset.collapsed = String(collapsed);
      fields.hidden = collapsed;
      heading.hidden = collapsed;
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute('aria-label', collapsed ? 'Show controls' : 'Hide controls');
    };
    try {
      setCollapsed(localStorage.getItem(COLLAPSED_KEY) === 'true');
    } catch {
      setCollapsed(false);
    }
    toggle.addEventListener('click', () => {
      const collapsed = root.dataset.collapsed !== 'true';
      setCollapsed(collapsed);
      try {
        localStorage.setItem(COLLAPSED_KEY, String(collapsed));
      } catch {
        // Private mode: it just won't be remembered.
      }
    });
    img.loading = 'eager'; // swapping photos shouldn't wait on lazy-loading
    let focusTouched = false;

    const val = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement).value;
    const checked = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).checked;
    const setVal = (name: string, v: string | number) => {
      (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement).value = String(v);
    };

    function render() {
      const o = {
        photo: val('photo'),
        align: val('align') as 'left' | 'right',
        tone: val('tone'),
        treatment: val('treatment'),
        wash: val('wash') as 'fade' | 'none',
        backdrop: val('backdrop'),
        shift: Number(val('shift')),
      };
      const autoFocus = o.align === 'right' ? '30% 35%' : '70% 35%';
      if (!focusTouched) {
        const [x, y] = autoFocus.split(' ').map(parseFloat);
        setVal('focusX', x);
        setVal('focusY', y);
      }
      const focus = focusTouched ? `${val('focusX')}% ${val('focusY')}%` : autoFocus;

      for (const k of ['align', 'tone', 'treatment', 'wash', 'backdrop'] as const) band.dataset[k] = o[k];
      const vars = { ...impactShiftVars(o.shift, o.align, o.wash), '--impact-focus': focus };
      for (const [k, v] of Object.entries(vars)) band.style.setProperty(k, v);

      const photo = photos.find((p) => p.key === o.photo) ?? photos[0];
      if (img.dataset.key !== photo.key) {
        img.srcset = photo.srcset;
        img.src = photo.src;
        img.alt = photo.alt;
        img.dataset.key = photo.key;
      }
      for (const [k, el] of Object.entries(parts)) if (el) el.hidden = !checked(k);

      (form.elements.namedItem('shiftOut') as HTMLOutputElement).value = String(o.shift);
      (form.elements.namedItem('focusOut') as HTMLOutputElement).value = focusTouched ? focus : 'auto';

      // Markup with only the non-default props.
      const props: string[] = ['as="h2"', 'image={photo}', `imageAlt="${photo.alt}"`];
      if (o.align !== 'left') props.push(`align="${o.align}"`);
      if (o.tone !== 'ink') props.push(`tone="${o.tone}"`);
      if (o.treatment !== 'fade') props.push(`treatment="${o.treatment}"`);
      if (o.wash !== 'fade') props.push(`wash="${o.wash}"`);
      if (o.backdrop !== 'auto') props.push(`backdrop="${o.backdrop}"`);
      if (o.shift) props.push(`shift={${o.shift}}`);
      if (focusTouched) props.push(`focus="${focus}"`);
      if (checked('eyebrow')) props.push('eyebrow="…"');
      props.push(`title={'Build your\\nown band.'}`);
      if (checked('body')) props.push('body="…"');
      if (checked('ghost')) props.push('ghost="Leftovers"');
      const inner = checked('actions') ? `>\n  <Button slot="actions" href="/join" variant="gold">Join a squad</Button>\n</ImpactBand>` : ' />';
      code.textContent = `<ImpactBand\n  ${props.join('\n  ')}\n${inner.startsWith('>') ? inner : inner.trim()}`;

      // The one rule a preset can't enforce for you.
      hint.textContent =
        o.wash === 'none' && checked('body') && o.backdrop !== 'panel'
          ? 'Body text over a full photo: use backdrop="panel" so it passes AA.'
          : '';

      // Name a preset only while the options still match it.
      const match = presets.findIndex((preset) =>
        Object.entries(preset.set).every(([k, v]) => String((o as Record<string, unknown>)[k]) === String(v))
      );
      setVal('preset', match < 0 ? '' : match);
    }

    form.addEventListener('input', (e) => {
      const name = (e.target as HTMLInputElement).name;
      if (name === 'focusX' || name === 'focusY') focusTouched = true;
      if (name === 'preset') {
        for (const [k, v] of Object.entries(presets[Number(val('preset'))].set)) setVal(k, v);
        focusTouched = false;
      }
      render();
    });
    root.querySelector('.pg-copy')!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    });
    render();
  }
</script>
