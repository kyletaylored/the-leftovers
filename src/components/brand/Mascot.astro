---
/**
 * Mascot — the takeout-box mascot (§9). A reusable brand asset, never
 * redrawn per page: it appears in the hero lockup, the "OPEN SLOT" player
 * card, the 404 page, and every empty state (see MascotCallout).
 *
 * `full`  — the illustrated white box (hero, open-slot card)
 * `line`  — gold line-art version (footer, small marks, empty states)
 *
 * Geometry is mirrored in scripts/make-og-default.mjs, which composes the
 * same drawing for the social card. Change one, change both.
 */
interface Props {
  variant?: 'full' | 'line';
  class?: string;
  /** Rising steam. Decorative; disabled under prefers-reduced-motion. */
  steam?: boolean;
}
const { variant = 'full', class: className = '', steam = true } = Astro.props;

const line = variant === 'line';
const stroke = line ? 'var(--color-gold)' : 'var(--color-ink)';
const paper = line ? 'none' : '#F7F5F0';
const noodle = line ? 'none' : '#E9C979';
const chopstick = line ? 'none' : 'var(--color-crimson)';
const stampFill = line ? 'none' : 'var(--color-crimson)';
const stampInk = line ? 'var(--color-gold)' : '#F7F5F0';
---

<svg
  viewBox="0 0 200 230"
  class={className}
  aria-hidden="true"
  role="presentation"
  focusable="false"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {/* steam */}
  {
    steam && (
      <g
        class="mascot-steam"
        stroke={line ? 'var(--color-gold)' : '#9A958C'}
        stroke-width={line ? 2.6 : 4}
        opacity="0.7"
      >
        <path d="M104 54c-15-9-15-23 0-32s15-23 0-32" />
      </g>
    )
  }

  {/* chopsticks — drawn first so the noodle mound overlaps their tips */}
  <g transform="rotate(-32 70 90)" stroke={stroke} stroke-width="2.8">
    <rect x="22" y="14" width="12" height="104" rx="6" fill={chopstick}></rect>
    <rect x="41" y="4" width="12" height="114" rx="6" fill={chopstick}></rect>
  </g>

  <g stroke={stroke} stroke-width="2.8">
    {/* top flaps, folded open */}
    <path d="M58 108 26 80l36-11 32 29Z" fill={paper}></path>
    <path d="M142 108l32-28-36-11-32 29Z" fill={paper}></path>

    {/* noodle mound */}
    <path d="M64 108c-3-27 14-46 36-46s39 19 36 46Z" fill={noodle}></path>
    <g fill="none" stroke-width="2.2" stroke-opacity="0.8">
      <path d="M74 102c-3-17 8-29 22-30"></path>
      <path d="M90 104c-4-15 2-26 15-28"></path>
      <path d="M108 104c1-13 7-21 17-21"></path>
    </g>

    {/* box body */}
    <path d="M54 106h92l-13 112H67Z" fill={paper}></path>
    <path d="M54 106l18 20h56l18-20" fill="none"></path>
  </g>

  {/* 剩饭 ("leftovers") stamp */}
  <g transform="translate(100 172)">
    <rect x="-15" y="-24" width="30" height="46" rx="3" fill={stampFill} stroke={stroke} stroke-width="2"
    ></rect>
    <text
      x="0"
      y="-4"
      text-anchor="middle"
      font-size="17"
      font-family="'Noto Serif SC','Songti SC','Hiragino Sans GB',serif"
      fill={stampInk}
      stroke="none">剩</text>
    <text
      x="0"
      y="15"
      text-anchor="middle"
      font-size="17"
      font-family="'Noto Serif SC','Songti SC','Hiragino Sans GB',serif"
      fill={stampInk}
      stroke="none">饭</text>
  </g>
</svg>

<style>
  .mascot-steam path {
    animation: steam-rise 5s ease-in-out infinite;
    transform-origin: 104px 40px;
  }
  @keyframes steam-rise {
    0%,
    100% {
      opacity: 0.45;
      transform: translateY(0) scaleY(1);
    }
    50% {
      opacity: 0.85;
      transform: translateY(-3px) scaleY(1.06);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot-steam path {
      animation: none;
    }
  }
</style>
