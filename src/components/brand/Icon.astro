---
/**
 * Icon — the brand icon set (style guide "ICON SET") plus the UI glyphs the
 * site needs. Single stroke weight, gold by default, 24x24 grid.
 *
 * Decorative by default (aria-hidden); pass a `label` when the icon is the
 * only content of a control, which makes it the accessible name.
 */
import { FILLED_ICONS, STROKED_ICONS, type IconName } from '@/lib/icons';

// Re-exported so existing `import Icon, { type IconName } from …/Icon.astro`
// call sites keep working. The path data itself lives in src/lib/icons.ts.
export type { IconName };

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  /** Solid-filled brand social glyphs vs. the stroked line set. */
  strokeWidth?: number;
}

const { name, class: className = 'size-6', label, strokeWidth = 1.8 } = Astro.props;

const filled = name in FILLED_ICONS;
const d = filled
  ? FILLED_ICONS[name as keyof typeof FILLED_ICONS]
  : STROKED_ICONS[name as keyof typeof STROKED_ICONS];
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : 'presentation'}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={d} />
</svg>
