---
/**
 * Icon — the brand icon set (style guide "ICON SET") plus the UI glyphs the
 * site needs. Single stroke weight, gold by default, 24x24 grid.
 *
 * Decorative by default (aria-hidden); pass a `label` when the icon is the
 * only content of a control, which makes it the accessible name.
 */
export type IconName =
  | 'lantern'
  | 'calendar'
  | 'chat'
  | 'jersey'
  | 'trophy'
  | 'chopsticks'
  | 'pin'
  | 'arrow-right'
  | 'external'
  | 'menu'
  | 'close'
  | 'mail'
  | 'chevron'
  | 'instagram'
  | 'discord'
  | 'youtube'
  | 'tiktok'
  | 'facebook'
  // Added per the Sept 2026 design-handoff audit (§03 icon set) — same 24×24
  // grid, 1.8 stroke weight, gold-on-dark as the rest of the stroked set.
  | 'cart'
  | 'leaderboard'
  | 'sponsor'
  | 'camera'
  | 'check'
  | 'sold-out';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  /** Solid-filled brand social glyphs vs. the stroked line set. */
  strokeWidth?: number;
}

