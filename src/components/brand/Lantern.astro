---
/**
 * Lantern — hanging lantern flourish (§9 motif / icon set).
 *
 * `variant="outline"` (default) is the original gold line drawing used as a
 * quiet ornament (NewsletterBlock). `variant="paper"` is the detailed paper
 * lantern from the Nov 2026 hero pass (`docs/design/homepage-mockup-b.webp`):
 * filled body with gold ribs, caps, tassel and a soft glow, in forest or
 * crimson. `sway` adds a slow pendulum swing (CSS only; reduced-motion users
 * get a still lantern via the global reduced-motion rule).
 *
 * Decorative: aria-hidden, no accessible name.
 */
import { uid } from '@/lib/uid';

interface Props {
  class?: string;
  /** How long the hanging cord is, in viewBox units. */
  cord?: number;
  color?: string;
  variant?: 'outline' | 'paper';
  /** `paper` only: body colour. */
  tone?: 'forest' | 'crimson';
  /** `paper` only: swing gently. `swayDelay` (s) offsets lanterns hung together. */
  sway?: boolean;
  swayDelay?: number;
  /** Inline positioning from a parent composition (CloudCorner). */
  style?: string;
}
const {
  class: className = '',
  cord = 60,
  color = 'var(--color-gold)',
  variant = 'outline',
  tone = 'forest',
  sway = false,
  swayDelay = 0,
  style = "",
} = Astro.props;

const body = tone === 'crimson' ? 'var(--color-crimson)' : 'var(--color-forest)';
const glowId = uid('lantern-glow');
const shadeId = uid('lantern-shade');
---

{
  variant === 'outline' ? (
    <svg
      viewBox={`0 0 60 ${cord + 110}`}
      class={className}
      aria-hidden="true"
      role="presentation"
      focusable="false"
    >
      <g stroke={color} stroke-width="2.2" fill="none">
        <line x1="30" y1="0" x2="30" y2={cord} />
        <g transform={`translate(0 ${cord})`}>
          <rect x="20" y="0" width="20" height="7" rx="1" />
          <ellipse cx="30" cy="34" rx="22" ry="27" fill="var(--color-forest)" fill-opacity="0.85" />
          <line x1="16" y1="16" x2="44" y2="16" />
          <line x1="13" y1="34" x2="47" y2="34" />
          <line x1="16" y1="52" x2="44" y2="52" />
          <rect x="20" y="61" width="20" height="7" rx="1" />
          <line x1="30" y1="68" x2="30" y2="88" />
          <line x1="24" y1="70" x2="24" y2="84" />
          <line x1="36" y1="70" x2="36" y2="84" />
        </g>
      </g>
    </svg>
  ) : (
    <svg
      viewBox={`0 0 80 ${cord + 132}`}
      class:list={[className, 'overflow-visible', sway && 'lantern-sway']}
      style={`${style};${sway ? `animation-delay:-${swayDelay}s` : ""}`}
      aria-hidden="true"
      role="presentation"
      focusable="false"
    >
      <defs>
        <radialGradient id={glowId}>
          <stop offset="0" stop-color="var(--color-gold)" stop-opacity="0.35" />
          <stop offset="1" stop-color="var(--color-gold)" stop-opacity="0" />
        </radialGradient>
        {/* Lit from inside: bright core, darker toward the rim. */}
        <radialGradient id={shadeId} cx="0.42" cy="0.42" r="0.62">
          <stop offset="0" stop-color="var(--color-gold)" stop-opacity="0.45" />
          <stop offset="0.55" stop-color="var(--color-gold)" stop-opacity="0.08" />
          <stop offset="1" stop-color="var(--color-ink)" stop-opacity="0.45" />
        </radialGradient>
      </defs>
      <line x1="40" y1="0" x2="40" y2={cord + 2} stroke={color} stroke-width="1.6" />
      <g transform={`translate(0 ${cord})`}>
        <circle cx="40" cy="48" r="44" fill={`url(#${glowId})`} />
        {/* top cap */}
        <path d="M30 2h20l3 9H27Z" fill="var(--color-gold-700)" stroke={color} stroke-width="1.4" stroke-linejoin="round" />
        {/* body */}
        <ellipse cx="40" cy="46" rx="27" ry="35" fill={body} />
        <ellipse cx="40" cy="46" rx="27" ry="35" fill={`url(#${shadeId})`} />
        <g fill="none" stroke={color} stroke-width="1.3">
          <ellipse cx="40" cy="46" rx="27" ry="35" stroke-width="1.8" />
          <ellipse cx="40" cy="46" rx="17" ry="35" stroke-opacity="0.75" />
          <ellipse cx="40" cy="46" rx="7.5" ry="35" stroke-opacity="0.6" />
          <path d="M16 28q24 -7 48 0M13.5 46h53M16 64q24 7 48 0" stroke-opacity="0.45" stroke-dasharray="3 3" />
        </g>
        {/* bottom cap + tassel */}
        <path d="M27 81h26l-3 8H30Z" fill="var(--color-gold-700)" stroke={color} stroke-width="1.4" stroke-linejoin="round" />
        <line x1="40" y1="89" x2="40" y2="97" stroke={color} stroke-width="1.6" />
        <circle cx="40" cy="99" r="2.6" fill={color} />
        <path d="M36.5 101h7l2 26h-11Z" fill={body} stroke={color} stroke-width="1.2" stroke-linejoin="round" />
        <g stroke={color} stroke-width="0.9" stroke-opacity="0.7">
          <line x1="38" y1="104" x2="37.4" y2="125" />
          <line x1="40" y1="104" x2="40" y2="125" />
          <line x1="42" y1="104" x2="42.6" y2="125" />
        </g>
      </g>
    </svg>
  )
}
