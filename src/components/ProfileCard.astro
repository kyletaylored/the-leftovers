---
/**
 * ProfileCard — the generic bio card (§7), for anyone who isn't a rostered
 * player: captain, coach, field contact. PlayerCard stays jersey-specific.
 */
import { Image } from 'astro:assets';
import Icon, { type IconName } from './brand/Icon.astro';

interface Props {
  name: string;
  role: string;
  image?: ImageMetadata;
  imageAlt?: string;
  links?: Array<{ icon: IconName; href: string; label: string }>;
  as?: 'h2' | 'h3';
  class?: string;
}
const { name, role, image, imageAlt, links = [], as: Heading = 'h3', class: className = '' } =
  Astro.props;
---

<article
  class:list={['flex gap-4 rounded-sm border border-ink-600 bg-ink-800 p-5', className]}
>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? `${name}, ${role}`}
        width={96}
        height={96}
        loading="lazy"
        decoding="async"
        class="size-20 shrink-0 rounded-sm object-cover sm:size-24"
      />
    )
  }
  <div class="min-w-0">
    <Heading class="text-lg text-bone sm:text-xl">{name}</Heading>
    <p class="mt-1 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-gold-300">{role}</p>
    <div class="mt-2 text-sm leading-relaxed text-bone-muted">
      <slot />
    </div>
    {
      links.length > 0 && (
        <ul class="mt-3 flex gap-2">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                rel="noopener"
                class="tap inline-flex items-center justify-center text-gold transition-colors hover:text-gold-300"
              >
                <Icon name={link.icon} class="size-5" label={`${name} on ${link.label}`} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
