---
/**
 * Seo — the complete per-page <head> metadata baseline (PRD §10.3).
 *
 * Canonical URL, title/description, OG + Twitter card, and an optional
 * JSON-LD graph. Every page routes its metadata through here so there is
 * exactly one place a tag can be missing from.
 *
 * The default share card is public/og-default.png (1200×630), rendered from
 * the real brand components by `npm run og` (see src/pages/design/og-card).
 * Its size is declared with og:image:width/height so platforms can lay out
 * the preview before fetching it. A page passing its own `ogImage` should
 * pass its size too, or the size tags are left out rather than guessed.
 */
import { site } from '@/lib/settings';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative image URL for the social card. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Pixel size of `ogImage`. Known for the default card; pass it for others. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** `article` for news/recap posts, `website` otherwise. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** schema.org objects to emit as a single @graph. */
  schema?: Array<Record<string, unknown>>;
}

const DEFAULT_OG = { src: '/og-default.png', width: 1200, height: 630 };

const {
  title,
  description = site.description,
  ogImage = DEFAULT_OG.src,
  ogImageAlt = `${site.title} logo with gilded clouds, paper lanterns and rice terraces: "Paintball builds better people."`,
  ogType = 'website',
  noindex = false,
  schema = [],
} = Astro.props;
const isDefaultOg = ogImage === DEFAULT_OG.src;
const ogWidth = Astro.props.ogImageWidth ?? (isDefaultOg ? DEFAULT_OG.width : undefined);
const ogHeight = Astro.props.ogImageHeight ?? (isDefaultOg ? DEFAULT_OG.height : undefined);
const ogMime = /\.png$/i.test(ogImage) ? 'image/png' : /\.jpe?g$/i.test(ogImage) ? 'image/jpeg' : /\.webp$/i.test(ogImage) ? 'image/webp' : undefined;

/**
 * Canonicalise the path before building the URL.
 *
 * With `build.format: 'file'`, Astro.url.pathname is the OUTPUT filename
 * during prerender ("/about.html"), while the sitemap, the nav and every
 * internal link use "/about". Emitting the raw pathname would point the
 * canonical tag at a different URL than the one being linked and submitted —
 * the exact self-inflicted duplicate-content problem canonicals exist to
 * prevent. Normalising here fixes it for every page at once.
 */
const canonicalPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/(.+)\/$/, '$1') || '/';
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const fullTitle =
  title === site.title ? (site.homeTitle ?? `${site.title} — ${site.tagline}`) : `${title} | ${site.title}`;

const graph =
  schema.length > 0
    ? { '@context': 'https://schema.org', '@graph': schema }
    : null;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{/* "follow": a hidden page's links still count, only the page itself stays out. */}
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
{site.search.googleSiteVerification && <meta name="google-site-verification" content={site.search.googleSiteVerification} />}
{site.search.bingSiteVerification && <meta name="msvalidate.01" content={site.search.bingSiteVerification} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
{ogMime && <meta property="og:image:type" content={ogMime} />}
{ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
{ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />}
